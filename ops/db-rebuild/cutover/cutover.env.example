# cutover.env の雛形。cutover.env にコピーして、本番ホスト上で値を埋める (cutover.env は .gitignore 済みで、秘密を含む。chmod 600)。
# 「要確認」の値は、本番ホストで確認して決める。実在の値をこのファイルへ書いて commit しない。

# ---- 本番の compose ----
COMPOSE_PROJECT=twitter-accounts-classifier
# 要確認: 本番の compose.yaml と .env があるディレクトリ (絶対パス)
PROD_COMPOSE_DIR=
PROD_COMPOSE_FILES="compose.yaml"
OLD_DB_SERVICE=postgres
# 要確認: 旧 DB のコンテナ名、データベース名、ロール。compose の crawler の DATABASE_URL と一致していること (preflight が照合する)
OLD_DB_CONTAINER=twitter-accounts-classifier-postgres-1
OLD_DB_NAME=
OLD_DB_USER=crawler
# 要確認: watchtower のコンテナ名 (名前かイメージに watchtower を含むコンテナは、すべて停止の対象として検査される)
WATCHTOWER_CONTAINER=watchtower
# 空なら旧 DB コンテナのネットワークを使う。アプリと旧 DB が同じネットワークにいない場合だけ指定する
APP_NETWORK=

# ---- 新 DB ----
NEW_CONTAINER=tac-new-postgres
# 新 DB の管理者 (initdb のブートストラップ)。アプリ用の crawler とは別名にする (ブートストラップのスーパーユーザーは降格できない)
NEW_DB_USER=tac_owner
NEW_DB_NAME=twitter_accounts_classifier
# 管理者の password (initdb が設定する)。強い値を新規に決める
NEW_DB_PASSWORD=
# アプリ用ロール (crawler) の password。アプリの DATABASE_URL に入る。強い値を新規に決める
NEW_APP_DB_PASSWORD=
# 要確認: 新 DB のデータ、WAL アーカイブ、ベースバックアップの置き場 (旧 DB と並べて作る)
NEW_DB_DATA_HOST_PATH=/mnt/ssd/twitter-accounts-classifier/postgres-new
NEW_DB_WAL_ARCHIVE_HOST_PATH=/mnt/ssd/twitter-accounts-classifier/postgres-new-wal-archive
NEW_DB_BACKUP_HOST_PATH=/mnt/ssd/twitter-accounts-classifier/postgres-new-backup
# リハーサルで決めた Tweet のパーティション方式: hash または range
TWEET_VARIANT=

# ---- 新コードのイメージ (build-images.sh の出力。latest は不可) ----
NEW_IMAGE_CRAWLER=
NEW_IMAGE_VIEWER=
NEW_IMAGE_BLOCKER=
NEW_IMAGE_ANALYZER=

# ---- 停止枠と見積もり ----
WINDOW_MINUTES=240
BUDGET_PERCENT=70
# 停止の待ち時間 (秒)。サービスの entrypoint は SIGTERM で終了せず、この時間の後に SIGKILL になるため、長くしても穏当な停止にはならない
STOP_TIMEOUT=30
# blocker の実行中の run が終わるのを待つ上限 (秒)
BLOCKER_IDLE_WAIT_SECS=900
# 残りがこれ未満なら切り替えへ進まない (分)
SWITCH_RESERVE_MINUTES=40
# リハーサルの外挿値 (秒)。全量の本番に合わせて、fio の実測も踏まえて置き換える
EST_PREPARE_SECS=
EST_LOAD_SECS=
EST_RESTORE_SECS=
EST_VERIFY_SECS=
# switch.sh の roles、steady (再起動、ANALYZE、ベースバックアップ)、gate の合計
EST_STEADY_SECS=

# ---- 保存場所 ----
STATE_DIR=/mnt/ssd/twitter-accounts-classifier/cutover-state

# ---- 移行の調整 (load.sh に渡る) ----
JOBS=2
# 旧データの changeType='updated' を残すか。残す場合は ENUM_UPDATED=1 も必要 (どちらにするかはユーザーの判断)
KEEP_UPDATED=true
ENUM_UPDATED=0

# ---- postcheck の調整 (任意) ----
# RELABEL_BASELINE_PER_MIN=
# ERR_RATE_FACTOR=2
# ERR_RATE_MIN_PER_HOUR=30
# VIEWER_PATHS="/api/health / /accounts /labels /system"
