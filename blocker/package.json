{
  "name": "blocker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r generated dist/generated",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "precheck": "pnpm run db:generate",
    "check": "run-p lint typecheck test",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma --generator blockerClient && node ../prisma/scripts/stringify-bigint-types.mjs"
  },
  "dependencies": {
    "@book000/node-utils": "1.26.35",
    "@prisma/client": "6.19.3",
    "@sentry/node": "11.14.0",
    "id-boundary": "workspace:*",
    "twitter-client": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.13.1",
    "@types/node": "26.6.11",
    "eslint": "9.39.5",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
