# weekly-crawl-review スキル専用。scripts/weekly-analyze.sh がこのファイルを
# .env の後に読み込み、DATABASE_URL を本番 Postgres の weekly_review ロール
# 接続文字列で上書きする。本番機の IP・パスワードが決まってから
# .env.weekly-review としてコピーし、値を埋めること (このファイル自体は
# 実際の接続情報を含まないため git 管理下に置いてよい)。
DATABASE_URL=postgresql://weekly_review:CHANGE_ME@CHANGE_ME_PROD_HOST:5432/twitter_accounts_classifier

# Weekly Review planner。planned sample の hard cap と、各 label から planner が
# risk/targeted 候補を作るために読む直近 AccountLabel の最大件数。
WEEKLY_REVIEW_SAMPLE_BUDGET=240
WEEKLY_REVIEW_CANDIDATE_POOL_SIZE=80
