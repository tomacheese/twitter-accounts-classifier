  validationSummary Json      @default("{}")
  analysisRunId     Int?

  @@index([modelKey, status, startedAt(sort: Desc)])
}

model ReadModelPointer {
  modelKey            String   @id
  currentGenerationId String
  switchedAt          DateTime @default(now()) @db.Timestamptz(3)
}

model ReadModelState {
  modelKey            String    @id
  schemaVersion       Int
  status              String    @default("unknown")
  currentGenerationId String?
  sourceWatermarkAt   DateTime? @db.Timestamptz(3)
  lastStartedAt       DateTime? @db.Timestamptz(3)
  lastSuccessAt       DateTime? @db.Timestamptz(3)
  lastFailureAt       DateTime? @db.Timestamptz(3)
  expectedNextAt      DateTime? @db.Timestamptz(3)
  delayedAt           DateTime? @db.Timestamptz(3)
  staleAt             DateTime? @db.Timestamptz(3)
  rowCount            Int?
  policyHash          String?
  analyzerVersion     String?
  errorCode           String?
  errorSummary        String?
}

// detector 固有の進捗を ReadModelState から分離する。
model DetectorState {
  detectorKey         String    @id
  lastEvidenceEpochId String?
  sourceWatermarkAt   DateTime? @db.Timestamptz(3)
  lastStartedAt       DateTime? @db.Timestamptz(3)
  lastSuccessAt       DateTime? @db.Timestamptz(3)
  lastFailureAt       DateTime? @db.Timestamptz(3)
  errorCode           String?
  errorSummary        String?
  policyHash          String?
  analyzerVersion     String?
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
}

// 各コンポーネントの起動時に自身の build identity を upsert する。
// component ごとに 1 行のみ保持し、直近起動時の値のみを表示対象とする。
model ComponentBuildIdentity {
  component          String    @id
  applicationVersion String
  gitRevision        String
  buildTime          DateTime? @db.Timestamptz(3)
  startedAt          DateTime  @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
}

model BioDuplicateClusterSize {
  clusterKey String   @id
  size       Int
  memberIds  BigInt[] @default([])
}
