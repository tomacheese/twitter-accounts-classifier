datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// crawler and viewer are independent pnpm workspace packages, each with its own
// node_modules tree, so a default (output-less) generator's implicit
// `node_modules/.prisma/client` resolution can't be reached from either package's
// own dependency tree. A custom `output` sidesteps node_modules resolution entirely.
generator client {
  provider = "prisma-client-js"
  output   = "../crawler/generated/prisma"
}

generator viewerClient {
  provider = "prisma-client-js"
  output   = "../viewer/generated/prisma"
}

model Account {
  id                       String         @id
  screenName               String
  displayName              String
  bio                      String?
  profileImageUrl          String?
  followersCount           Int
  followingCount           Int
  tweetCount               Int
  accountCreatedAt         DateTime
  location                 String?
  url                      String?
  isBlueVerified           Boolean        @default(false)
  verifiedType             String?
  professionalType         String?
  parodyCommentaryFanLabel String?
  firstSeenAt              DateTime       @default(now())
  lastCrawledAt            DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  tweets                   Tweet[]
  labels                   AccountLabel[]
  latestLabels             AccountLabelLatest[]
  followerEdges            Follow[]       @relation("FollowerEdges")
  followeeEdges            Follow[]       @relation("FolloweeEdges")

  // The Accounts page (viewer/lib/queries/accounts.ts's listAccounts) sorts by
  // whichever of these three columns the user picked, with no other filter in
  // the common case - without an index Postgres has to sort the whole table
  // on every page load as Account grows.
  @@index([followersCount])
  @@index([tweetCount])
  @@index([lastCrawledAt])
}

model Tweet {
  id                         String   @id
  accountId                  String
  account                    Account  @relation(fields: [accountId], references: [id])
  fullText                   String
  createdAt                  DateTime
  retweetCount               Int
  likeCount                  Int
  replyCount                 Int
  quoteCount                 Int
  isReply                    Boolean  @default(false)
  inReplyToTweetId           String?
  isAuthorReply              Boolean  @default(false)
  isRetweet                  Boolean  @default(false)
  retweetedTweetId           String?
  isPromoted                 Boolean  @default(false)
  isPaidPromotion            Boolean  @default(false)
  // No default (null): rows collected before this column existed were never evaluated
  // for AI-generated media at all, and null keeps that "unknown" state distinct from a
  // real false/true reported by a subsequent fetch. See the migration for detail.
  hasAiGeneratedMedia        Boolean?
  aiGeneratedDetectionSource String?
  // No default (null), same "unknown vs. confirmed" convention as hasAiGeneratedMedia
  // above. See the migration for detail.
  quotedTweetId              String?
  quotedTweetAuthorId        String?
  quotedTweetHasVideo        Boolean?
  source                     String
  collectedAt                DateTime @default(now())

  @@index([accountId])
}

model LabelDefinition {
  id                  String               @id @default(cuid())
  key                 String               @unique
  description         String
  createdAt           DateTime             @default(now())
  accountLabels       AccountLabel[]
  accountLabelsLatest AccountLabelLatest[]
}

model AccountLabel {
  id                String          @id @default(cuid())
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  value             Boolean
  confidence        Float
  reason            String
  method            String
  ruleVersion       String
  labeledAt         DateTime        @default(now())

  @@index([accountId])
  @@index([labelDefinitionId])
  @@index([labeledAt])
  // crawler/relabel.ts の loadLatestRuleVersions が実行する
  // `DISTINCT ON ("accountId", "labelDefinitionId") ... ORDER BY "accountId",
  // "labelDefinitionId", "labeledAt" DESC, "id" DESC` にそのまま一致させる
  // ためのインデックス。AccountLabelLatest は ruleVersion を持たないため、
  // このバックフィル用クエリだけは AccountLabel の履歴を直接引き続ける。
  @@index([accountId, labelDefinitionId, labeledAt(sort: Desc), id(sort: Desc)])
}

// 履歴テーブルである AccountLabel (アカウント詳細ページの監査証跡として全件を
// 保持し続けるため、クロールを重ねるたびに際限なく増える) から DISTINCT ON で
// 「account/label ごとの最新値」を導出すると全件スキャンになり、本番の
// ダッシュボード/アカウント一覧クエリの statement_timeout を常態的に超過する
// ようになった。このテーブルは (accountId, labelDefinitionId) ごとの最新値のみ
// を保持し、recordAccountLabel が AccountLabel への履歴 INSERT と同時に upsert
// する。そのためこれらの集計クエリは履歴の総件数ではなく (アカウント数 x
// ラベル数) で頭打ちになる。この経緯の説明はここを正としており、
// crawler/db/label-repository.ts・viewer/lib/queries/dashboard.ts・
// viewer/lib/queries/accounts.ts・対応するマイグレーションのコメントは
// ここへの参照のみとする。
model AccountLabelLatest {
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  value             Boolean
  labeledAt         DateTime

  @@id([accountId, labelDefinitionId])
  // value = true で絞り込む dashboard.ts/accounts.ts の各クエリを支える。
  @@index([labelDefinitionId, value])
  @@index([value, accountId])
}

model WeeklyAnalysisRun {
  id                String    @id @default(cuid())
  startedAt         DateTime
  finishedAt        DateTime?
  sampledAccountIds Json
  findings          String?
  commitSha         String?
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Account  @relation("FollowerEdges", fields: [followerId], references: [id])
  followeeId  String
  followee    Account  @relation("FolloweeEdges", fields: [followeeId], references: [id])
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

model CrawlRun {
  id               String                   @id @default(cuid())
  startedAt        DateTime
  finishedAt       DateTime?
  status           String
  accountRuns      CrawlAccountRun[]
  checkpoints      CrawlAccountCheckpoint[]
  accountLabelRuns CrawlAccountLabelRun[]

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model CrawlAccountRun {
  id                 String    @id @default(cuid())
  crawlRunId         String
  crawlRun           CrawlRun  @relation(fields: [crawlRunId], references: [id])
  username           String
  startedAt          DateTime
  finishedAt         DateTime?
  status             String
  recommendedCount   Int       @default(0)
  followingCount     Int       @default(0)
  trendingCount      Int       @default(0)
  replyCount         Int       @default(0)
  profileCount       Int       @default(0)
  labelsAppliedCount Int       @default(0)
  followingSynced    Boolean   @default(false)
  followersSynced    Boolean   @default(false)
  warnings           Json      @default("[]")
  errorMessage       String?

  @@index([crawlRunId])
  @@index([startedAt])
  @@index([crawlRunId, username, startedAt(sort: Desc), id(sort: Desc)])
}

model CrawlAccountCheckpoint {
  id          String   @id @default(cuid())
  crawlRunId  String
  crawlRun    CrawlRun @relation(fields: [crawlRunId], references: [id])
  username    String
  phase       String
  data        Json
  completedAt DateTime @default(now())

  @@unique([crawlRunId, username, phase])
  @@index([crawlRunId, username])
}

model CrawlAccountLabelRun {
  id                String   @id @default(cuid())
  crawlRunId        String
  crawlRun          CrawlRun @relation(fields: [crawlRunId], references: [id])
  username          String
  accountId         String
  labelDefinitionId String
  method            String
  ruleVersion       String
  createdAt         DateTime @default(now())

  @@unique([crawlRunId, username, accountId, labelDefinitionId, method, ruleVersion])
}
