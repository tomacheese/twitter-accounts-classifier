datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// crawler と viewer は別々の pnpm ワークスペースパッケージであり、
// それぞれ独立した node_modules を持つため、
// output を指定しないデフォルトの生成先はどちらのパッケージからも解決できない。
// そのため output で生成先を明示的に指定している。
generator client {
  provider = "prisma-client-js"
  output   = "../crawler/generated/prisma"
}

generator viewerClient {
  provider = "prisma-client-js"
  output   = "../viewer/generated/prisma"
}

generator blockerClient {
  provider = "prisma-client-js"
  output   = "../blocker/generated/prisma"
}

generator analyzerClient {
  provider = "prisma-client-js"
  output   = "../analyzer/generated/prisma"
}

model Account {
  id                             String                 @id
  screenName                     String
  displayName                    String
  bio                            String?
  profileImageUrl                String?
  followersCount                 Int
  followingCount                 Int
  tweetCount                     Int
  accountCreatedAt               DateTime
  location                       String?
  url                            String?
  isBlueVerified                 Boolean                @default(false)
  verifiedType                   String?
  professionalType               String?
  parodyCommentaryFanLabel       String?
  firstSeenAt                    DateTime               @default(now())
  lastCrawledAt                  DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  tweets                         Tweet[]
  labels                         AccountLabel[]
  latestLabels                   AccountLabelLatest[]
  followerEdges                  Follow[]               @relation("FollowerEdges")
  followeeEdges                  Follow[]               @relation("FolloweeEdges")
  labelingFollowSampleAsAccount  LabelingFollowSample[] @relation("LabelingFollowSampleAccount")
  labelingFollowSampleAsFollowee LabelingFollowSample[] @relation("LabelingFollowSampleFollowee")
  blockerEdges                   Block[]                @relation("BlockerEdges")
  blockedEdges                   Block[]                @relation("BlockedEdges")
  blockActionsAsBlocker          BlockAction[]          @relation("BlockActionBlocker")
  blockActionsAsBlocked          BlockAction[]          @relation("BlockActionBlocked")
  blockOutboxEntriesAsBlocker    BlockOutboxEntry[]     @relation("BlockOutboxBlocker")
  blockOutboxEntriesAsBlocked    BlockOutboxEntry[]     @relation("BlockOutboxBlocked")

  // この3カラムは絞り込みなしで並び替えに使われうるため、
  // インデックスがないと行数増加に伴い全件ソートが発生する。
  @@index([followersCount])
  @@index([tweetCount])
  @@index([lastCrawledAt])
}

model Tweet {
  id                         String   @id
  accountId                  String
  account                    Account  @relation(fields: [accountId], references: [id])
  fullText                   String
  createdAt                  DateTime
  retweetCount               Int
  likeCount                  Int
  replyCount                 Int
  quoteCount                 Int
  isReply                    Boolean  @default(false)
  inReplyToTweetId           String?
  isAuthorReply              Boolean  @default(false)
  isRetweet                  Boolean  @default(false)
  retweetedTweetId           String?
  isPromoted                 Boolean  @default(false)
  isPaidPromotion            Boolean  @default(false)
  expandedUrls               String[] @default([])
  // この列が存在する前に収集された行は判定自体が行われていないため、
  // デフォルトを false ではなく null にして未評価の状態と実際の判定結果を区別している。
  hasAiGeneratedMedia        Boolean?
  aiGeneratedDetectionSource String?
  quotedTweetId              String?
  quotedTweetAuthorId        String?
  // hasAiGeneratedMedia と同じ理由で、
  // 未評価行を区別するためデフォルトを設定せず null のままにしている。
  quotedTweetHasVideo        Boolean?
  foreignVideoSourceCount    Int?
  source                     String
  collectedAt                DateTime @default(now())

  @@index([accountId, createdAt])
  // reply corpus 用の collectedAt/id 降順索引は isReply = true への部分索引であり、
  // Prisma の schema DSL では WHERE 句を表現できないため、
  // migration 20260811090000_add_reply_corpus_partial_index の raw SQL で管理する。
}

model LabelDefinition {
  id                  String               @id @default(cuid())
  key                 String               @unique
  description         String
  currentRuleVersion  String?
  createdAt           DateTime             @default(now())
  accountLabels       AccountLabel[]
  accountLabelsLatest AccountLabelLatest[]
  labelAggregate      LabelAggregate?
  blockActions        BlockAction[]
  blockOutboxEntries  BlockOutboxEntry[]
}

model AccountLabel {
  id                String          @id @default(cuid())
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  value             Boolean
  confidence        Float
  reason            String
  method            String
  ruleVersion       String
  evaluable         Boolean         @default(true)
  labeledAt         DateTime        @default(now())
  // 発生源追跡: どの Crawl・relabel・Weekly Review・backfill が作った行かを監査可能にする。
  // 既存行は sourceKind = "legacy"、sourceId = null とし、推定 backfill しない。
  sourceKind        String          @default("legacy")
  sourceId          String?
  sourceUsername    String?

  // account-detail.ts の accountId 絞り込みにはこの単一インデックスで足りる。
  // labeledAt 降順の並び替え性能まで複合インデックスで確保する必要はないと判断している。
  // ルールバージョン検索は AccountLabelLatest で足りるため、AccountLabel 側には置かない。
  @@index([accountId])
  @@index([labeledAt(sort: Desc), id(sort: Desc)])
  @@index([labelDefinitionId, labeledAt(sort: Desc), id(sort: Desc)])
  @@index([sourceKind, sourceId])
  // weekly-review の listRecentCandidates/listPopulationCounts が行う
  // DISTINCT ON (labelDefinitionId, accountId) ORDER BY labeledAt DESC, id DESC を
  // インデックススキャンで処理できるよう、この並び順で複合インデックスを用意する。
  @@index([labelDefinitionId, accountId, labeledAt(sort: Desc), id(sort: Desc)])
}

// AccountLabel は監査証跡としてほぼ無制限に増え続ける履歴テーブルであり、
// そこから DISTINCT ON で最新値を都度導出すると、
// ダッシュボードやアカウント一覧のクエリが全件スキャンになり本番の応答時間を守れない。
// そのため (accountId, labelDefinitionId) ごとの最新値のみを保持する専用テーブルとして用意し、
// recordCrawlAccountLabel 等が AccountLabel への履歴 INSERT と同時に upsert する。
// crawler/db/label-repository.ts・crawler/db/label-aggregate-repository.ts・
// viewer/lib/queries/accounts.ts・対応するマイグレーションのコメントは、
// この経緯の説明をここへの参照のみとし、重複させない。
model AccountLabelLatest {
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  value             Boolean
  confidence        Float
  reason            String
  method            String
  ruleVersion       String
  evaluable         Boolean         @default(true)
  labeledAt         DateTime
  sourceKind        String          @default("legacy")
  sourceId          String?
  sourceUsername    String?

  @@id([accountId, labelDefinitionId])
  // value = true で絞り込む dashboard.ts/accounts.ts の各クエリを支えるインデックス。
  @@index([labelDefinitionId, value])
  @@index([value, accountId])
  // viewer の relabel coverage クエリを支えるインデックス。
  @@index([labelDefinitionId, ruleVersion])
}

// AccountLabelLatest から都度集計すると全件 Seq Scan になり本番の応答時間を守れないため、
// crawler がラベリング完了時に計算した結果をここへ書き込み、viewer はここだけを読む。
model LabelAggregate {
  labelDefinitionId String          @id
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  labelKey          String
  labelDescription  String
  trueCount         Int
  totalCount        Int
  updatedAt         DateTime

  @@index([labelKey])
}

// 集計処理自体の成否と全体件数を LabelAggregate とは別テーブルに分けているのは、
// 集計失敗時に LabelAggregate 側を上書きせず前回成功時点の値を残したまま、
// 「前回成功時点の値を表示中かどうか」だけをこのテーブルで viewer から判別できるようにするため。
model LabelAggregateStatus {
  id                String    @id
  labeledAccounts   Int
  lastSuccessAt     DateTime?
  lastAttemptAt     DateTime
  lastAttemptStatus String
  lastErrorMessage  String?
}

model WeeklyAnalysisRun {
  id                String    @id @default(cuid())
  startedAt         DateTime
  lastHeartbeatAt   DateTime
  finishedAt        DateTime?
  staleAfterAt      DateTime?
  status            String
  currentPhase      String?
  errorMessage      String?
  pullRequestNumber Int?
  pullRequestUrl    String?
  sampledAccountIds Json
  findings          String?
  commitSha         String?
  targetFrom        DateTime?
  targetTo          DateTime?
  analysisVersion   String?
  modelIdentity     String?
  toolIdentity      String?
  policyHash        String?
  reviewPlan        Json?
  structuredOutput  Json?

  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Account  @relation("FollowerEdges", fields: [followerId], references: [id])
  followeeId  String
  followee    Account  @relation("FolloweeEdges", fields: [followeeId], references: [id])
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

model LabelingFollowSample {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation("LabelingFollowSampleAccount", fields: [accountId], references: [id])
  followeeId String
  followee   Account  @relation("LabelingFollowSampleFollowee", fields: [followeeId], references: [id])
  fetchedAt  DateTime @default(now())

  @@unique([accountId, followeeId])
  @@index([accountId])
  @@index([followeeId])
}

model Block {
  id                      String    @id @default(cuid())
  blockerId               String
  blocker                 Account   @relation("BlockerEdges", fields: [blockerId], references: [id])
  blockedId               String
  blocked                 Account   @relation("BlockedEdges", fields: [blockedId], references: [id])
  firstSeenAt             DateTime  @default(now())
  lastSeenAt              DateTime  @default(now())
  // 完全同期で対象が存在しない場合のみ論理状態を進める。物理削除はしない。
  status                  String    @default("active")
  lastCheckedAt           DateTime  @default(now())
  missingSinceAt          DateTime?
  resolvedAt              DateTime?
  consecutiveMissingCount Int       @default(0)
  sourceKind              String    @default("legacy")
  sourceId                String?

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@index([status, lastCheckedAt(sort: Desc)])
}

model CrawlRun {
  id                      String                   @id @default(cuid())
  startedAt               DateTime
  lastHeartbeatAt         DateTime
  finishedAt              DateTime?
  status                  String
  currentUsername         String?
  currentAccountStartedAt DateTime?
  staleAfterAt            DateTime?
  accountRuns             CrawlAccountRun[]
  checkpoints             CrawlAccountCheckpoint[]
  accountLabelRuns        CrawlAccountLabelRun[]
  authorCheckpoints       CrawlAuthorCheckpoint[]

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model CrawlAccountRun {
  id                   String    @id @default(cuid())
  crawlRunId           String
  crawlRun             CrawlRun  @relation(fields: [crawlRunId], references: [id])
  username             String
  startedAt            DateTime
  finishedAt           DateTime?
  status               String
  recommendedCount     Int       @default(0)
  followingCount       Int       @default(0)
  trendingCount        Int       @default(0)
  replyCount           Int       @default(0)
  profileCount         Int       @default(0)
  labelsAppliedCount   Int       @default(0)
  followingSynced      Boolean   @default(false)
  followersSynced      Boolean   @default(false)
  blocksSynced         Boolean   @default(false)
  warnings             Json      @default("[]")
  errorMessage         String?
  /// crawler イメージに埋め込まれた APPLICATION_VERSION (Docker のビルド引数)。
  /// 値が取得できない場合は "unknown" になる。
  /// この行を最終的に確定させたビルドを表しており、
  /// 個々の warning を発生させたビルドは warnings 内の各要素が持つ appVersion を参照する。
  appVersion           String    @default("unknown")
  classificationStatus String    @default("unknown")

  @@index([crawlRunId])
  @@index([startedAt])
  @@index([crawlRunId, username, startedAt(sort: Desc), id(sort: Desc)])
}

model CrawlAccountCheckpoint {
  id          String   @id @default(cuid())
  crawlRunId  String
  crawlRun    CrawlRun @relation(fields: [crawlRunId], references: [id])
  username    String
  phase       String
  data        Json
  completedAt DateTime @default(now())

  @@unique([crawlRunId, username, phase])
  @@index([crawlRunId, username])
}

model CrawlAccountLabelRun {
  id                String   @id @default(cuid())
  crawlRunId        String
  crawlRun          CrawlRun @relation(fields: [crawlRunId], references: [id])
  username          String
  accountId         String
  labelDefinitionId String
  method            String
  ruleVersion       String
  createdAt         DateTime @default(now())

  @@unique([crawlRunId, username, accountId, labelDefinitionId, method, ruleVersion])
}

model CrawlAuthorCheckpoint {
  id                 String   @id @default(cuid())
  crawlRunId         String
  crawlRun           CrawlRun @relation(fields: [crawlRunId], references: [id])
  username           String
  authorId           String
  status             String
  profileCount       Int      @default(0)
  labelsAppliedCount Int      @default(0)
  warnings           Json     @default("[]")
  durationMs         Int?
  retryWaitMs        Int?
  appVersion         String   @default("unknown")
  completedAt        DateTime @default(now())

  @@unique([crawlRunId, username, authorId])
  @@index([crawlRunId, username])
}

// activeLabelKeys (text[]) への GIN index は既定の array ops で表現できるため、本来は Prisma の schema DSL でも宣言できる。
// ただしこの index は CONCURRENTLY 付きで作成する必要があり、生成される migration がそれに対応しないため、実体は migration 20260810210740_add_account_summary_latest_active_label_keys_gin_idx の raw SQL で作成する。
// ここでの @@index 宣言は、shadow database の diff がこの index を誤って DROP 対象と判断するのを防ぐためのものである。
model AccountSummaryLatest {
  accountId                   String    @id
  normalizedScreenName        String
  normalizedDisplayName       String
  searchDocument              String
  profileObservedAt           DateTime
  activeLabelKeys             String[]
  activeLabelCount            Int
  lastClassificationChangedAt DateTime?
  classificationObservedAt    DateTime?
  activeFindingCount          Int       @default(0)
  highestFindingSeverity      String?
  findingObservedAt           DateTime?
  updatedAt                   DateTime  @updatedAt

  @@index([lastClassificationChangedAt(sort: Desc), accountId])
  @@index([highestFindingSeverity, activeFindingCount, accountId])
  @@index([normalizedScreenName])
  @@index([activeLabelKeys], type: Gin, map: "AccountSummaryLatest_activeLabelKeys_gin_idx")
}

model AccountClassificationLatest {
  accountId           String
  labelDefinitionId   String
  value               Boolean
  confidence          Float
  reason              String
  method              String
  ruleVersion         String
  observedAt          DateTime
  sourceObservationId String?

  @@id([accountId, labelDefinitionId])
  @@index([labelDefinitionId, value, accountId])
}

model AccountClassificationValueCount {
  labelDefinitionId String
  value             Boolean
  count             Int      @default(0)
  confidenceSum     Float    @default(0)

  @@id([labelDefinitionId, value])
}

model AccountClassificationConfidenceBucketCount {
  labelDefinitionId String
  confidenceBucket  Int
  count             Int      @default(0)

  @@id([labelDefinitionId, confidenceBucket])
}

model AccountClassificationRuleVersionCount {
  labelDefinitionId String
  ruleVersion       String
  count             Int      @default(0)

  @@id([labelDefinitionId, ruleVersion])
}

model AccountClassificationFreshnessBucket {
  labelDefinitionId String
  observedAtBucket  DateTime
  count             Int      @default(0)

  @@id([labelDefinitionId, observedAtBucket])
}

model AccountClassificationObservation {
  id         String   @id @default(cuid())
  accountId  String
  crawlRunId String?
  username   String?
  observedAt DateTime
  labelCount Int
  createdAt  DateTime @default(now())

  @@index([accountId, observedAt(sort: Desc)])
}

model ReadModelBootstrap {
  modelKey       String    @id
  status         String    @default("pending")
  cursor         String?
  processedCount Int       @default(0)
  startedAt      DateTime?
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  errorSummary   String?
}

model BlockRun {
  id              String            @id @default(cuid())
  startedAt       DateTime
  lastHeartbeatAt DateTime
  finishedAt      DateTime?
  status          String
  staleAfterAt    DateTime?
  accountRuns     BlockAccountRun[]

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model BlockAccountRun {
  id              String             @id @default(cuid())
  blockRunId      String
  blockRun        BlockRun           @relation(fields: [blockRunId], references: [id])
  username        String
  startedAt       DateTime
  finishedAt      DateTime?
  status          String
  candidatesCount Int                @default(0)
  blockedCount    Int                @default(0)
  failedCount     Int                @default(0)
  errorMessage    String?
  actions         BlockAction[]
  outboxEntries   BlockOutboxEntry[]

  @@index([blockRunId])
  @@index([blockRunId, username, startedAt(sort: Desc), id(sort: Desc)])
  @@index([errorMessage, startedAt(sort: Desc), id(sort: Desc)])
}

model BlockAction {
  id                String            @id @default(cuid())
  blockAccountRunId String
  blockAccountRun   BlockAccountRun   @relation(fields: [blockAccountRunId], references: [id])
  blockerId         String
  blocker           Account           @relation("BlockActionBlocker", fields: [blockerId], references: [id])
  blockedId         String
  blocked           Account           @relation("BlockActionBlocked", fields: [blockedId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition   @relation(fields: [labelDefinitionId], references: [id])
  confidence        Float
  result            String
  errorMessage      String?
  createdAt         DateTime          @default(now())
  outboxEntryId     String?           @unique
  outboxEntry       BlockOutboxEntry? @relation(fields: [outboxEntryId], references: [id])

  // selectBlockCandidates が「過去に result = 'success' の BlockAction が存在するか」を
  // (blockerId, blockedId) 単位で調べるためのインデックス。
  @@index([blockerId, blockedId, result])
  @@index([blockAccountRunId])
}

// createBlock (remote) 実行前に durable な intent を作ることで、DB 障害でどの段階が失敗しても直前に確定した状態が残るようにする。
// (blockerId, blockedId) の一意制約により同一ペアの outbox entry は常に 1 件に保たれ、中断や再選定後の再開は既存行の再利用で行う。
model BlockOutboxEntry {
  id                String          @id @default(cuid())
  blockAccountRunId String
  blockAccountRun   BlockAccountRun @relation(fields: [blockAccountRunId], references: [id])
  blockerId         String
  blocker           Account         @relation("BlockOutboxBlocker", fields: [blockerId], references: [id])
  blockedId         String
  blocked           Account         @relation("BlockOutboxBlocked", fields: [blockedId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  confidence        Float
  status            String
  remoteSkipCount     Int             @default(0)
  lastRemoteSkippedAt DateTime?
  createdAt         DateTime        @default(now())
  remoteSucceededAt DateTime?
  localPersistedAt  DateTime?
  reconciledAt      DateTime?
  actions           BlockAction[]

  @@unique([blockerId, blockedId])
  @@index([status, createdAt])
}

// analyzer が処理する耐久キュー。at-least-once を前提とし、
// exactly-once は装わない。冪等性は出力側の unique constraint で担保する。
model AnalysisWorkItem {
  id               String        @id @default(cuid())
  kind             String
  triggerType      String
  triggerId        String
  status           String        @default("queued")
  priority         Int           @default(0)
  availableAt      DateTime      @default(now())
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  attemptCount     Int           @default(0)
  maxAttempts      Int           @default(5)
  dependencyKey    String?
  // account_relabel 専用: lease 中に新しい変更要求が来たことを示すマーカー。
  // complete 時にこれが設定されていれば succeeded にせず queued へ戻す(他 kind では未使用)。
  staleRequestedAt DateTime?
  lastErrorCode    String?
  lastErrorSummary String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  runs             AnalysisRun[]

  // 同じ完了イベントを複数回通知しても WorkItem を重複生成しないための論理一意キー。
  @@unique([kind, triggerType, triggerId])
  // FOR UPDATE SKIP LOCKED での claim 用。
  @@index([status, availableAt, priority])
}

model AnalysisRun {
  id            String            @id @default(cuid())
  // WorkItem は 30 日、AnalysisRun は 180 日と保持期間が異なる。cascade delete だと
  // WorkItem の retention sweep のたびに紐づく AnalysisRun も年齢を問わず消えてしまうため、
  // nullable FK + SetNull にして WorkItem 削除後も AnalysisRun 自身の retention sweep まで残す。
  workItemId    String?
  workItem      AnalysisWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  attemptNumber Int
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  status        String
  errorCode     String?
  errorSummary  String?

  @@index([workItemId, startedAt(sort: Desc)])
}

// account_relabel producer の incremental scan 位置を永続化する singleton テーブル。
// 1 行だけを持ち、id は常に固定値 "singleton" を使う。
model RelabelScanCursor {
  id                   String   @id @default("singleton")
  lastScannedAccountId String?
  updatedAt            DateTime @updatedAt
}

model OperationCycle {
  id                String           @id @default(cuid())
  kind              String
  sourceType        String
  sourceId          String
  triggeredAt       DateTime
  expectedAt        DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  status            String           @default("scheduled")
  attentionRequired Boolean          @default(false)
  currentStageKey   String?
  sourceWatermarkAt DateTime?
  modelVersion      String
  updatedAt         DateTime         @updatedAt
  stages            OperationStage[]

  @@unique([sourceType, sourceId])
  @@index([kind, startedAt(sort: Desc), id(sort: Desc)])
  @@index([kind, triggeredAt(sort: Desc), id(sort: Desc)])
  @@index([attentionRequired, status])
}

model OperationStage {
  id            String         @id @default(cuid())
  cycleId       String
  cycle         OperationCycle @relation(fields: [cycleId], references: [id])
  stageKey      String
  sequence      Int
  requiredness  String
  status        String         @default("waiting")
  attemptCount  Int            @default(0)
  sourceType    String?
  sourceId      String?
  expectedAt    DateTime?
  delayedAt     DateTime?
  staleAt       DateTime?
  startedAt     DateTime?
  heartbeatAt   DateTime?
  finishedAt    DateTime?
  counters      Json           @default("{}")
  errorCode     String?
  errorSummary  String?
  analysisRunId String?

  @@unique([cycleId, stageKey])
  @@index([cycleId, sequence])
}

model OperationalIssue {
  id                  String                       @id @default(cuid())
  component           String
  type                String
  fingerprint         String
  status              String                       @default("active")
  severity            String
  firstDetectedAt     DateTime                     @default(now())
  lastDetectedAt      DateTime                     @default(now())
  resolvedAt          DateTime?
  currentOccurrenceId String?
  sourceCycleId       String?
  sourceStageId       String?
  occurrences         OperationalIssueOccurrence[]

  @@unique([fingerprint])
  @@index([status, severity, lastDetectedAt(sort: Desc), id(sort: Desc)])
}

model OperationalIssueOccurrence {
  id              String           @id @default(cuid())
  issueId         String
  issue           OperationalIssue @relation(fields: [issueId], references: [id])
  observedAt      DateTime         @default(now())
  stateTransition String
  severity        String
  sourceType      String
  sourceId        String
  measurements    Json             @default("{}")
  observationKey  String

  @@unique([issueId, observationKey])
  @@index([issueId, observedAt(sort: Desc), id(sort: Desc)])
}

model ReviewFinding {
  id                    String                    @id @default(cuid())
  fingerprint           String
  identityVersion       Int
  episodeNumber         Int                       @default(1)
  type                  String
  primaryScopeType      String
  primaryScopeId        String
  status                String                    @default("active")
  currentSeverity       String
  maximumSeverity       String
  firstDetectedAt       DateTime                  @default(now())
  lastDetectedAt        DateTime                  @default(now())
  resolvedAt            DateTime?
  recurrenceCount       Int                       @default(0)
  previousFindingId     String?
  supersededByFindingId String?
  currentOccurrenceId   String?
  occurrences           ReviewFindingOccurrence[]
  evidences             FindingEvidence[]
  entityLinks           FindingEntityLink[]

  @@unique([fingerprint, identityVersion, episodeNumber])
  @@index([status, currentSeverity, lastDetectedAt(sort: Desc), id(sort: Desc)])
  @@index([primaryScopeType, primaryScopeId])
}

model ReviewFindingOccurrence {
  id                 String        @id @default(cuid())
  findingId          String
  finding            ReviewFinding @relation(fields: [findingId], references: [id])
  observedAt         DateTime      @default(now())
  // observedAt は analyzer がこの Occurrence を書き込んだ処理時刻であり、lifecycle の
  // クールダウン判定に使う。crawl/weekly review の元データ自体の時刻とは異なるため、
  // AccountSummary 側で sourceWatermarkAt と比較する際はこちらを使う。
  sourceObservedAt   DateTime
  stateTransition    String
  severity           String
  sourceType         String
  sourceId           String
  observedValue      Float?
  baselineValue      Float?
  absoluteDifference Float?
  relativeDifference Float?
  affectedCount      Int?
  totalCount         Int?
  affectedRatio      Float?
  consecutiveCount   Int           @default(0)
  confidence         Float?
  thresholds         Json          @default("{}")
  measurements       Json          @default("{}")
  policyHash         String
  detectorVersion    String
  observationKey     String

  @@unique([findingId, observationKey])
  @@index([findingId, observedAt(sort: Desc), id(sort: Desc)])
  @@index([findingId, sourceObservedAt(sort: Desc), id(sort: Desc)])
}

model FindingEvidence {
  id                    String        @id @default(cuid())
  findingId             String
  finding               ReviewFinding @relation(fields: [findingId], references: [id])
  kind                  String
  schemaVersion         Int
  redactionVersion      Int
  sampleStrategyVersion String?
  payload               Json
  createdAt             DateTime      @default(now())

  @@index([findingId, kind, createdAt(sort: Desc)])
}

// Raw Analysis や大容量 artifact を遅延取得できるよう Finding 本体から分離する。
// 1 件 1 MiB を超える内容は書き込み時に切り詰め、isTruncated を立てる。
model FindingRawArtifact {
  id          String   @id @default(cuid())
  findingId   String
  kind        String
  content     String
  isTruncated Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([findingId, kind])
}

model FindingEntityLink {
  id         String        @id @default(cuid())
  findingId  String
  finding    ReviewFinding @relation(fields: [findingId], references: [id])
  entityType String
  entityId   String

  @@unique([findingId, entityType, entityId])
  @@index([entityType, entityId])
}

model DetectionPolicyVersion {
  id            String   @id @default(cuid())
  policyVersion String   @unique
  contentHash   String
  schemaVersion Int
  content       Json
  loadedAt      DateTime @default(now())
}

// active 化前の候補を含む detector 評価結果。通常の Review 一覧には表示しない。
model DetectorEvaluation {
  id              String   @id @default(cuid())
  detectorType    String
  fingerprint     String
  identityVersion Int
  // 同一観測イベント (例: 同じ CrawlRun) の at-least-once retry で
  // DetectorEvaluation が重複しないための論理一意キー。
  sourceId        String
  evaluatedAt     DateTime @default(now())
  isShadow        Boolean  @default(false)
  result          Json
  policyHash      String

  @@unique([fingerprint, identityVersion, sourceId, isShadow])
  @@index([detectorType, fingerprint, evaluatedAt(sort: Desc)])
  @@index([isShadow, evaluatedAt(sort: Desc)])
  @@index([fingerprint, identityVersion, evaluatedAt(sort: Desc)])
}

model PolicyBacktestRun {
  id                  String                  @id @default(cuid())
  candidatePolicyHash String
  baselinePolicyHash  String
  targetFrom          DateTime
  targetTo            DateTime
  startedAt           DateTime                @default(now())
  finishedAt          DateTime?
  status              String                  @default("running")
  summary             Json                    @default("{}")
  findings            PolicyBacktestFinding[]
}

model PolicyBacktestFinding {
  id          String            @id @default(cuid())
  runId       String
  run         PolicyBacktestRun @relation(fields: [runId], references: [id])
  fingerprint String
  severity    String
  diffKind    String
  detail      Json              @default("{}")

  @@index([runId, diffKind])
}

model LabelMetricSnapshot {
  id                      String   @id @default(cuid())
  sourceCrawlRunId        String?
  triggerWorkItemId       String
  labelDefinitionId       String
  observedAt              DateTime
  generatedAt             DateTime @default(now())
  sourceWatermarkAt       DateTime
  populationCount         Int      @default(0)
  evaluatedCount          Int
  trueCount               Int
  prevalence              Float
  coverage                Float    @default(0)
  currentCount            Int      @default(0)
  delayedCount            Int      @default(0)
  staleCount              Int      @default(0)
  unknownCount            Int      @default(0)
  staleRatio              Float    @default(0)
  trueConfidenceAverage   Float?
  falseConfidenceAverage  Float?
  confidenceBuckets       Json     @default("{}")
  reasonDistribution      Json     @default("{}")
  ruleVersionDistribution Json     @default("{}")
  completeness            String
  policyHash              String
  analyzerVersion         String
  analysisRunId           String?

  @@unique([triggerWorkItemId, labelDefinitionId])
  @@index([labelDefinitionId, observedAt(sort: Desc), id(sort: Desc)])
}

model LabelMetricDaily {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  labelDefinitionId  String
  evaluatedCount     Int
  trueCount          Int
  prevalence         Float
  confidenceBuckets  Json     @default("{}")
  reasonDistribution Json     @default("{}")
  // この行の値が採用された元 LabelMetricSnapshot.observedAt。
  // 遅延して実行された backlog 分の build が、それより新しい observedAt を
  // 採用済みの行を古い値へ巻き戻すのを防ぐ判定にのみ使う。
  sourceObservedAt   DateTime

  @@unique([date, labelDefinitionId])
  @@index([labelDefinitionId, date(sort: Desc)])
}

// sourceId (CrawlRun.id) を分類更新の再試行冪等キーとして使う。
// 同じ CrawlRun による retry では sourceId が変わらず一致する。
// sourceId が null の行 (直接呼び出しや legacy データ) は Postgres の仕様上
// NULL 同士が重複と判定されないため、この場合は冪等性の保証対象外になる。
model AccountLabelChange {
  id                 String   @id @default(cuid())
  accountId          String
  labelDefinitionId  String
  changeType         String
  previousValue      Boolean?
  newValue           Boolean?
  previousConfidence Float?
  newConfidence      Float?
  previousReason     String?
  newReason          String?
  sourceId           String?
  changedAt          DateTime @default(now())

  // changedAt には集計 build の watermark ではなく、変化の原因になった
  // AccountLabel 行自身の labeledAt を入れる。同じ変化イベントは
  // ANALYZER_WORKER_CONCURRENCY > 1 で並行 build しても常に同じ labeledAt
  // を指すため、sourceId (どの build が記録したか) ではなく変化イベント自体の
  // 同一性で重複排除できる。sourceId は NULL 同士が重複と判定されない
  // (Postgres の仕様) ため、この一意制約には使えない。
  @@unique([accountId, labelDefinitionId, changedAt])
  @@index([accountId, changedAt(sort: Desc)])
  @@index([labelDefinitionId, changedAt(sort: Desc), id(sort: Desc)])
  @@index([changedAt(sort: Desc), id(sort: Desc)])
}

model LabelSummaryCurrent {
  generationId           String
  labelDefinitionId      String
  latestSnapshotId       String?
  evaluatedCount         Int
  trueCount              Int
  populationCount        Int      @default(0)
  coverage               Float    @default(0)
  prevalence             Float
  previousRunDelta       Float?
  dayDelta               Float?
  weekDelta              Float?
  confidenceShift        Json     @default("{}")
  reasonShift            Json     @default("{}")
  activeFindingCount     Int      @default(0)
  highestFindingSeverity String?
  qualityStatus          String
  sourceWatermarkAt      DateTime
  updatedAt              DateTime @updatedAt

  @@id([generationId, labelDefinitionId])
  @@index([generationId, qualityStatus])
}

model BlockRelationCurrent {
  generationId                String
  blockId                     String
  normalizedBlockerScreenName String
  normalizedBlockedScreenName String
  status                      String
  statusChangedAt             DateTime
  activeFindingCount          Int      @default(0)
  highestFindingSeverity      String?
  sourceWatermarkAt           DateTime

  @@id([generationId, blockId])
  @@index([generationId, status, statusChangedAt(sort: Desc), blockId])
}

model BlockStateChange {
  id         String   @id @default(cuid())
  blockId    String
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())
  sourceId   String?

  @@index([blockId, changedAt(sort: Desc), id(sort: Desc)])
}

// Overview の Attention Queue 用に OperationalIssue と ReviewFinding を正規化する
// 読み取りモデル。正本ではなく、独自ライフサイクルを持たない (元データへの参照必須)。
model AttentionItemCurrent {
  generationId String
  sourceType   String
  sourceId     String
  category     String
  priority     Int
  severity     String
  summary      String
  impact       Json     @default("{}")
  detectedAt   DateTime
  freshness    String
  detailHref   String

  @@id([generationId, sourceType, sourceId])
  @@index([generationId, priority])
}

model OverviewSnapshot {
  id                String   @id @default(cuid())
  // ReadModelGeneration.id と 1:1 に対応させ、Pointer 経由の原子的公開に乗せるためのキー。
  generationId      String   @unique
  schemaVersion     Int
  generatedAt       DateTime @default(now())
  sourceWatermarkAt DateTime
  operationalStatus String
  qualityStatus     String
  payload           Json
  analysisRunId     String?

  @@index([generatedAt(sort: Desc)])
}

model ReadModelGeneration {
  id                String    @id @default(cuid())
  modelKey          String
  schemaVersion     Int
  status            String    @default("building")
  sourceWatermarkAt DateTime?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  rowCount          Int?
  validationSummary Json      @default("{}")
  analysisRunId     String?

  @@index([modelKey, status, startedAt(sort: Desc)])
}

model ReadModelPointer {
  modelKey            String   @id
  currentGenerationId String
  switchedAt          DateTime @default(now())
}

model ReadModelState {
  modelKey            String    @id
  schemaVersion       Int
  status              String    @default("unknown")
  currentGenerationId String?
  sourceWatermarkAt   DateTime?
  lastStartedAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  expectedNextAt      DateTime?
  delayedAt           DateTime?
  staleAt             DateTime?
  rowCount            Int?
  policyHash          String?
  analyzerVersion     String?
  errorCode           String?
  errorSummary        String?
}

// 各コンポーネントの起動時に自身の build identity を upsert する。
// component ごとに 1 行のみ保持し、直近起動時の値のみを表示対象とする。
model ComponentBuildIdentity {
  component          String    @id
  applicationVersion String
  gitRevision        String
  buildTime          DateTime?
  startedAt          DateTime
  updatedAt          DateTime  @updatedAt
}
