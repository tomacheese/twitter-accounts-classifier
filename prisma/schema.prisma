datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// crawler と viewer は別々の pnpm ワークスペースパッケージであり、
// それぞれ独立した node_modules を持つため、
// output を指定しないデフォルトの生成先はどちらのパッケージからも解決できない。
// そのため output で生成先を明示的に指定している。
generator client {
  provider = "prisma-client-js"
  output   = "../crawler/generated/prisma"
}

generator viewerClient {
  provider = "prisma-client-js"
  output   = "../viewer/generated/prisma"
}

generator blockerClient {
  provider = "prisma-client-js"
  output   = "../blocker/generated/prisma"
}

model Account {
  id                             String                 @id
  screenName                     String
  displayName                    String
  bio                            String?
  profileImageUrl                String?
  followersCount                 Int
  followingCount                 Int
  tweetCount                     Int
  accountCreatedAt               DateTime
  location                       String?
  url                            String?
  isBlueVerified                 Boolean                @default(false)
  verifiedType                   String?
  professionalType               String?
  parodyCommentaryFanLabel       String?
  firstSeenAt                    DateTime               @default(now())
  lastCrawledAt                  DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  tweets                         Tweet[]
  labels                         AccountLabel[]
  latestLabels                   AccountLabelLatest[]
  followerEdges                  Follow[]               @relation("FollowerEdges")
  followeeEdges                  Follow[]               @relation("FolloweeEdges")
  labelingFollowSampleAsAccount  LabelingFollowSample[] @relation("LabelingFollowSampleAccount")
  labelingFollowSampleAsFollowee LabelingFollowSample[] @relation("LabelingFollowSampleFollowee")
  blockerEdges                   Block[]                @relation("BlockerEdges")
  blockedEdges                   Block[]                @relation("BlockedEdges")
  blockActionsAsBlocker          BlockAction[]          @relation("BlockActionBlocker")
  blockActionsAsBlocked          BlockAction[]          @relation("BlockActionBlocked")

  // この3カラムは絞り込みなしで並び替えに使われうるため、
  // インデックスがないと行数増加に伴い全件ソートが発生する。
  @@index([followersCount])
  @@index([tweetCount])
  @@index([lastCrawledAt])
}

model Tweet {
  id                         String   @id
  accountId                  String
  account                    Account  @relation(fields: [accountId], references: [id])
  fullText                   String
  createdAt                  DateTime
  retweetCount               Int
  likeCount                  Int
  replyCount                 Int
  quoteCount                 Int
  isReply                    Boolean  @default(false)
  inReplyToTweetId           String?
  isAuthorReply              Boolean  @default(false)
  isRetweet                  Boolean  @default(false)
  retweetedTweetId           String?
  isPromoted                 Boolean  @default(false)
  isPaidPromotion            Boolean  @default(false)
  // この列が存在する前に収集された行は判定自体が行われていないため、
  // デフォルトを false ではなく null にして未評価の状態と実際の判定結果を区別している。
  hasAiGeneratedMedia        Boolean?
  aiGeneratedDetectionSource String?
  quotedTweetId              String?
  quotedTweetAuthorId        String?
  // hasAiGeneratedMedia と同じ理由で、
  // 未評価行を区別するためデフォルトを設定せず null のままにしている。
  quotedTweetHasVideo        Boolean?
  foreignVideoSourceCount    Int?
  source                     String
  collectedAt                DateTime @default(now())

  @@index([accountId])
}

model LabelDefinition {
  id                  String               @id @default(cuid())
  key                 String               @unique
  description         String
  createdAt           DateTime             @default(now())
  accountLabels       AccountLabel[]
  accountLabelsLatest AccountLabelLatest[]
  blockActions        BlockAction[]
}

model AccountLabel {
  id                String          @id @default(cuid())
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  value             Boolean
  confidence        Float
  reason            String
  method            String
  ruleVersion       String
  labeledAt         DateTime        @default(now())
  // 発生源追跡: どの Crawl・relabel・Weekly Review・backfill が作った行かを監査可能にする。
  // 既存行は sourceKind = "legacy"、sourceId = null とし、推定 backfill しない。
  sourceKind        String          @default("legacy")
  sourceId          String?
  sourceUsername    String?

  // account-detail.ts の accountId 絞り込みにはこの単一インデックスで足りる。
  // labeledAt 降順の並び替え性能まで複合インデックスで確保する必要はないと判断している。
  // ルールバージョン検索は AccountLabelLatest で足りるため、AccountLabel 側には置かない。
  @@index([accountId])
  @@index([labeledAt(sort: Desc), id(sort: Desc)])
  @@index([labelDefinitionId, labeledAt(sort: Desc), id(sort: Desc)])
  @@index([sourceKind, sourceId])
}

// AccountLabel は監査証跡としてほぼ無制限に増え続ける履歴テーブルであり、
// そこから DISTINCT ON で最新値を都度導出すると、
// ダッシュボードやアカウント一覧のクエリが全件スキャンになり本番の応答時間を守れない。
// そのため (accountId, labelDefinitionId) ごとの最新値のみを保持する専用テーブルとして用意し、
// recordCrawlAccountLabel 等が AccountLabel への履歴 INSERT と同時に upsert する。
// crawler/db/label-repository.ts・viewer/lib/queries/dashboard.ts・
// viewer/lib/queries/accounts.ts・対応するマイグレーションのコメントは、
// この経緯の説明をここへの参照のみとし、重複させない。
model AccountLabelLatest {
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  value             Boolean
  confidence        Float
  reason            String
  method            String
  ruleVersion       String
  labeledAt         DateTime
  sourceKind        String          @default("legacy")
  sourceId          String?
  sourceUsername    String?

  @@id([accountId, labelDefinitionId])
  // value = true で絞り込む dashboard.ts/accounts.ts の各クエリを支えるインデックス。
  @@index([labelDefinitionId, value])
  @@index([value, accountId])
}

model WeeklyAnalysisRun {
  id                String    @id @default(cuid())
  startedAt         DateTime
  lastHeartbeatAt   DateTime
  finishedAt        DateTime?
  staleAfterAt      DateTime?
  status            String
  currentPhase      String?
  errorMessage      String?
  pullRequestNumber Int?
  pullRequestUrl    String?
  sampledAccountIds Json
  findings          String?
  commitSha         String?

  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Account  @relation("FollowerEdges", fields: [followerId], references: [id])
  followeeId  String
  followee    Account  @relation("FolloweeEdges", fields: [followeeId], references: [id])
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

model LabelingFollowSample {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation("LabelingFollowSampleAccount", fields: [accountId], references: [id])
  followeeId String
  followee   Account  @relation("LabelingFollowSampleFollowee", fields: [followeeId], references: [id])
  fetchedAt  DateTime @default(now())

  @@unique([accountId, followeeId])
  @@index([accountId])
  @@index([followeeId])
}

model Block {
  id                      String    @id @default(cuid())
  blockerId               String
  blocker                 Account   @relation("BlockerEdges", fields: [blockerId], references: [id])
  blockedId               String
  blocked                 Account   @relation("BlockedEdges", fields: [blockedId], references: [id])
  firstSeenAt             DateTime  @default(now())
  lastSeenAt              DateTime  @default(now())
  // 完全同期で対象が存在しない場合のみ論理状態を進める。物理削除はしない。
  status                  String    @default("active")
  lastCheckedAt           DateTime  @default(now())
  missingSinceAt          DateTime?
  resolvedAt              DateTime?
  consecutiveMissingCount Int       @default(0)
  sourceKind              String    @default("legacy")
  sourceId                String?

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@index([status, lastCheckedAt(sort: Desc)])
}

model CrawlRun {
  id                      String                   @id @default(cuid())
  startedAt               DateTime
  lastHeartbeatAt         DateTime
  finishedAt              DateTime?
  status                  String
  currentUsername         String?
  currentAccountStartedAt DateTime?
  staleAfterAt            DateTime?
  accountRuns             CrawlAccountRun[]
  checkpoints             CrawlAccountCheckpoint[]
  accountLabelRuns        CrawlAccountLabelRun[]

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model CrawlAccountRun {
  id                 String    @id @default(cuid())
  crawlRunId         String
  crawlRun           CrawlRun  @relation(fields: [crawlRunId], references: [id])
  username           String
  startedAt          DateTime
  finishedAt         DateTime?
  status             String
  recommendedCount   Int       @default(0)
  followingCount     Int       @default(0)
  trendingCount      Int       @default(0)
  replyCount         Int       @default(0)
  profileCount       Int       @default(0)
  labelsAppliedCount Int       @default(0)
  followingSynced    Boolean   @default(false)
  followersSynced    Boolean   @default(false)
  blocksSynced       Boolean   @default(false)
  warnings           Json      @default("[]")
  errorMessage       String?
  /// crawler イメージに埋め込まれた APPLICATION_VERSION (Docker のビルド引数)。
  /// 値が取得できない場合は "unknown" になる。
  /// この行を最終的に確定させたビルドを表しており、
  /// 個々の warning を発生させたビルドは warnings 内の各要素が持つ appVersion を参照する。
  appVersion         String    @default("unknown")

  @@index([crawlRunId])
  @@index([startedAt])
  @@index([crawlRunId, username, startedAt(sort: Desc), id(sort: Desc)])
}

model CrawlAccountCheckpoint {
  id          String   @id @default(cuid())
  crawlRunId  String
  crawlRun    CrawlRun @relation(fields: [crawlRunId], references: [id])
  username    String
  phase       String
  data        Json
  completedAt DateTime @default(now())

  @@unique([crawlRunId, username, phase])
  @@index([crawlRunId, username])
}

model CrawlAccountLabelRun {
  id                String   @id @default(cuid())
  crawlRunId        String
  crawlRun          CrawlRun @relation(fields: [crawlRunId], references: [id])
  username          String
  accountId         String
  labelDefinitionId String
  method            String
  ruleVersion       String
  createdAt         DateTime @default(now())

  @@unique([crawlRunId, username, accountId, labelDefinitionId, method, ruleVersion])
}

model BlockRun {
  id              String            @id @default(cuid())
  startedAt       DateTime
  lastHeartbeatAt DateTime
  finishedAt      DateTime?
  status          String
  staleAfterAt    DateTime?
  accountRuns     BlockAccountRun[]

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model BlockAccountRun {
  id              String        @id @default(cuid())
  blockRunId      String
  blockRun        BlockRun      @relation(fields: [blockRunId], references: [id])
  username        String
  startedAt       DateTime
  finishedAt      DateTime?
  status          String
  candidatesCount Int           @default(0)
  blockedCount    Int           @default(0)
  failedCount     Int           @default(0)
  errorMessage    String?
  actions         BlockAction[]

  @@index([blockRunId])
  @@index([blockRunId, username, startedAt(sort: Desc), id(sort: Desc)])
  @@index([errorMessage, startedAt(sort: Desc), id(sort: Desc)])
}

model BlockAction {
  id                String          @id @default(cuid())
  blockAccountRunId String
  blockAccountRun   BlockAccountRun @relation(fields: [blockAccountRunId], references: [id])
  blockerId         String
  blocker           Account         @relation("BlockActionBlocker", fields: [blockerId], references: [id])
  blockedId         String
  blocked           Account         @relation("BlockActionBlocked", fields: [blockedId], references: [id])
  labelDefinitionId String
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  confidence        Float
  result            String
  errorMessage      String?
  createdAt         DateTime        @default(now())

  // selectBlockCandidates が「過去に result = 'success' の BlockAction が存在するか」を
  // (blockerId, blockedId) 単位で調べるためのインデックス。
  @@index([blockerId, blockedId, result])
  @@index([blockAccountRunId])
}

// analyzer が処理する耐久キュー。at-least-once を前提とし、
// exactly-once は装わない。冪等性は出力側の unique constraint で担保する。
model AnalysisWorkItem {
  id               String        @id @default(cuid())
  kind             String
  triggerType      String
  triggerId        String
  status           String        @default("queued")
  priority         Int           @default(0)
  availableAt      DateTime      @default(now())
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  attemptCount     Int           @default(0)
  maxAttempts      Int           @default(5)
  dependencyKey    String?
  lastErrorCode    String?
  lastErrorSummary String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  runs             AnalysisRun[]

  // 同じ完了イベントを複数回通知しても WorkItem を重複生成しないための論理一意キー。
  @@unique([kind, triggerType, triggerId])
  // FOR UPDATE SKIP LOCKED での claim 用。
  @@index([status, availableAt, priority])
}

model AnalysisRun {
  id            String           @id @default(cuid())
  workItemId    String
  workItem      AnalysisWorkItem @relation(fields: [workItemId], references: [id])
  attemptNumber Int
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  status        String
  errorCode     String?
  errorSummary  String?

  @@index([workItemId, startedAt(sort: Desc)])
}

model OperationCycle {
  id                String           @id @default(cuid())
  kind              String
  sourceType        String
  sourceId          String
  triggeredAt       DateTime
  expectedAt        DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  status            String           @default("scheduled")
  attentionRequired Boolean          @default(false)
  currentStageKey   String?
  sourceWatermarkAt DateTime?
  modelVersion      String
  updatedAt         DateTime         @updatedAt
  stages            OperationStage[]

  @@unique([sourceType, sourceId])
  @@index([kind, startedAt(sort: Desc), id(sort: Desc)])
  @@index([attentionRequired, status])
}

model OperationStage {
  id            String         @id @default(cuid())
  cycleId       String
  cycle         OperationCycle @relation(fields: [cycleId], references: [id])
  stageKey      String
  sequence      Int
  requiredness  String
  status        String         @default("waiting")
  attemptCount  Int            @default(0)
  sourceType    String?
  sourceId      String?
  expectedAt    DateTime?
  delayedAt     DateTime?
  staleAt       DateTime?
  startedAt     DateTime?
  heartbeatAt   DateTime?
  finishedAt    DateTime?
  counters      Json           @default("{}")
  errorCode     String?
  errorSummary  String?
  analysisRunId String?

  @@unique([cycleId, stageKey])
  @@index([cycleId, sequence])
}

model OperationalIssue {
  id                  String                       @id @default(cuid())
  component           String
  type                String
  fingerprint         String
  status              String                       @default("active")
  severity            String
  firstDetectedAt     DateTime                     @default(now())
  lastDetectedAt      DateTime                     @default(now())
  resolvedAt          DateTime?
  currentOccurrenceId String?
  sourceCycleId       String?
  sourceStageId       String?
  occurrences         OperationalIssueOccurrence[]

  @@unique([fingerprint])
  @@index([status, severity, lastDetectedAt(sort: Desc), id(sort: Desc)])
}

model OperationalIssueOccurrence {
  id              String           @id @default(cuid())
  issueId         String
  issue           OperationalIssue @relation(fields: [issueId], references: [id])
  observedAt      DateTime         @default(now())
  stateTransition String
  severity        String
  sourceType      String
  sourceId        String
  measurements    Json             @default("{}")
  observationKey  String

  @@unique([issueId, observationKey])
  @@index([issueId, observedAt(sort: Desc), id(sort: Desc)])
}

model ReviewFinding {
  id                    String                    @id @default(cuid())
  fingerprint           String
  identityVersion       Int
  episodeNumber         Int                       @default(1)
  type                  String
  primaryScopeType      String
  primaryScopeId        String
  status                String                    @default("active")
  currentSeverity       String
  maximumSeverity       String
  firstDetectedAt       DateTime                  @default(now())
  lastDetectedAt        DateTime                  @default(now())
  resolvedAt            DateTime?
  recurrenceCount       Int                       @default(0)
  previousFindingId     String?
  supersededByFindingId String?
  currentOccurrenceId   String?
  occurrences           ReviewFindingOccurrence[]
  evidences             FindingEvidence[]
  entityLinks           FindingEntityLink[]

  @@unique([fingerprint, identityVersion, episodeNumber])
  @@index([status, currentSeverity, lastDetectedAt(sort: Desc), id(sort: Desc)])
  @@index([primaryScopeType, primaryScopeId])
}

model ReviewFindingOccurrence {
  id                 String        @id @default(cuid())
  findingId          String
  finding            ReviewFinding @relation(fields: [findingId], references: [id])
  observedAt         DateTime      @default(now())
  stateTransition    String
  severity           String
  sourceType         String
  sourceId           String
  observedValue      Float?
  baselineValue      Float?
  absoluteDifference Float?
  relativeDifference Float?
  affectedCount      Int?
  totalCount         Int?
  affectedRatio      Float?
  consecutiveCount   Int           @default(0)
  confidence         Float?
  thresholds         Json          @default("{}")
  measurements       Json          @default("{}")
  policyHash         String
  detectorVersion    String
  observationKey     String

  @@unique([findingId, observationKey])
  @@index([findingId, observedAt(sort: Desc), id(sort: Desc)])
}

model FindingEvidence {
  id                    String        @id @default(cuid())
  findingId             String
  finding               ReviewFinding @relation(fields: [findingId], references: [id])
  kind                  String
  schemaVersion         Int
  redactionVersion      Int
  sampleStrategyVersion String?
  payload               Json
  createdAt             DateTime      @default(now())

  @@index([findingId, kind, createdAt(sort: Desc)])
}

// Raw Analysis や大容量 artifact を遅延取得できるよう Finding 本体から分離する。
// 1 件 1 MiB を超える内容は書き込み時に切り詰め、isTruncated を立てる。
model FindingRawArtifact {
  id          String   @id @default(cuid())
  findingId   String
  kind        String
  content     String
  isTruncated Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([findingId, kind])
}

model FindingEntityLink {
  id         String        @id @default(cuid())
  findingId  String
  finding    ReviewFinding @relation(fields: [findingId], references: [id])
  entityType String
  entityId   String

  @@unique([findingId, entityType, entityId])
  @@index([entityType, entityId])
}

model DetectionPolicyVersion {
  id            String   @id @default(cuid())
  policyVersion String   @unique
  contentHash   String
  schemaVersion Int
  content       Json
  loadedAt      DateTime @default(now())
}

// active 化前の候補を含む detector 評価結果。通常の Review 一覧には表示しない。
model DetectorEvaluation {
  id              String   @id @default(cuid())
  detectorType    String
  fingerprint     String
  identityVersion Int
  evaluatedAt     DateTime @default(now())
  isShadow        Boolean  @default(false)
  result          Json
  policyHash      String

  @@index([detectorType, fingerprint, evaluatedAt(sort: Desc)])
  @@index([isShadow, evaluatedAt(sort: Desc)])
}

model PolicyBacktestRun {
  id                  String                  @id @default(cuid())
  candidatePolicyHash String
  baselinePolicyHash  String
  targetFrom          DateTime
  targetTo            DateTime
  startedAt           DateTime                @default(now())
  finishedAt          DateTime?
  status              String                  @default("running")
  summary             Json                    @default("{}")
  findings            PolicyBacktestFinding[]
}

model PolicyBacktestFinding {
  id          String            @id @default(cuid())
  runId       String
  run         PolicyBacktestRun @relation(fields: [runId], references: [id])
  fingerprint String
  severity    String
  diffKind    String
  detail      Json              @default("{}")

  @@index([runId, diffKind])
}

model LabelMetricSnapshot {
  id                      String   @id @default(cuid())
  sourceCrawlRunId        String
  labelDefinitionId       String
  observedAt              DateTime
  generatedAt             DateTime @default(now())
  sourceWatermarkAt       DateTime
  evaluatedCount          Int
  trueCount               Int
  prevalence              Float
  trueConfidenceAverage   Float?
  falseConfidenceAverage  Float?
  confidenceBuckets       Json     @default("{}")
  reasonDistribution      Json     @default("{}")
  ruleVersionDistribution Json     @default("{}")
  completeness            String
  policyHash              String
  analyzerVersion         String
  analysisRunId           String?

  @@unique([sourceCrawlRunId, labelDefinitionId])
  @@index([labelDefinitionId, observedAt(sort: Desc), id(sort: Desc)])
}

model LabelMetricDaily {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  labelDefinitionId  String
  evaluatedCount     Int
  trueCount          Int
  prevalence         Float
  confidenceBuckets  Json     @default("{}")
  reasonDistribution Json     @default("{}")

  @@unique([date, labelDefinitionId])
  @@index([labelDefinitionId, date(sort: Desc)])
}

// normalizedDisplayName の部分一致検索は pg_trgm の GIN インデックスで支える
// (Task 5 Step 2b の raw SQL で作成する。Prisma の schema DSL では表現できない)。
model AccountSummaryCurrent {
  generationId                String
  accountId                   String
  normalizedScreenName        String
  normalizedDisplayName       String
  searchDocument              String
  activeLabelKeys             String[]
  activeLabelCount            Int
  lastClassificationChangedAt DateTime?
  lastRuleVersionChangedAt    DateTime?
  activeFindingCount          Int       @default(0)
  highestFindingSeverity      String?
  sourceWatermarkAt           DateTime
  updatedAt                   DateTime  @updatedAt

  @@id([generationId, accountId])
  @@index([generationId, lastClassificationChangedAt(sort: Desc), accountId])
  @@index([generationId, highestFindingSeverity, activeFindingCount, accountId])
  @@index([normalizedScreenName])
}

model AccountClassificationCurrent {
  generationId      String
  accountId         String
  labelDefinitionId String
  value             Boolean
  confidence        Float
  reason            String
  lastChangedAt     DateTime

  @@id([generationId, accountId, labelDefinitionId])
  @@index([generationId, labelDefinitionId, value, accountId])
}

model AccountLabelChange {
  id                 String   @id @default(cuid())
  accountId          String
  labelDefinitionId  String
  changeType         String
  previousValue      Boolean?
  newValue           Boolean?
  previousConfidence Float?
  newConfidence      Float?
  previousReason     String?
  newReason          String?
  sourceId           String?
  changedAt          DateTime @default(now())

  @@index([accountId, changedAt(sort: Desc)])
  @@index([labelDefinitionId, changedAt(sort: Desc), id(sort: Desc)])
}

model LabelSummaryCurrent {
  generationId           String
  labelDefinitionId      String
  latestSnapshotId       String?
  evaluatedCount         Int
  trueCount              Int
  prevalence             Float
  previousRunDelta       Float?
  dayDelta               Float?
  weekDelta              Float?
  confidenceShift        Json     @default("{}")
  reasonShift            Json     @default("{}")
  activeFindingCount     Int      @default(0)
  highestFindingSeverity String?
  qualityStatus          String
  sourceWatermarkAt      DateTime
  updatedAt              DateTime @updatedAt

  @@id([generationId, labelDefinitionId])
  @@index([generationId, qualityStatus])
}

model BlockRelationCurrent {
  generationId                String
  blockId                     String
  normalizedBlockerScreenName String
  normalizedBlockedScreenName String
  status                      String
  statusChangedAt             DateTime
  activeFindingCount          Int      @default(0)
  highestFindingSeverity      String?
  sourceWatermarkAt           DateTime

  @@id([generationId, blockId])
  @@index([generationId, status, statusChangedAt(sort: Desc), blockId])
}

model BlockStateChange {
  id         String   @id @default(cuid())
  blockId    String
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())
  sourceId   String?

  @@index([blockId, changedAt(sort: Desc), id(sort: Desc)])
}

// Overview の Attention Queue 用に OperationalIssue と ReviewFinding を正規化する
// 読み取りモデル。正本ではなく、独自ライフサイクルを持たない (元データへの参照必須)。
model AttentionItemCurrent {
  generationId String
  sourceType   String
  sourceId     String
  category     String
  priority     Int
  severity     String
  summary      String
  impact       Json     @default("{}")
  detectedAt   DateTime
  freshness    String
  detailHref   String

  @@id([generationId, sourceType, sourceId])
  @@index([generationId, priority])
}

model OverviewSnapshot {
  id                String   @id @default(cuid())
  schemaVersion     Int
  generatedAt       DateTime @default(now())
  sourceWatermarkAt DateTime
  operationalStatus String
  qualityStatus     String
  payload           Json
  analysisRunId     String?

  @@index([generatedAt(sort: Desc)])
}

model ReadModelGeneration {
  id                String    @id @default(cuid())
  modelKey          String
  schemaVersion     Int
  status            String    @default("building")
  sourceWatermarkAt DateTime?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  rowCount          Int?
  validationSummary Json      @default("{}")
  analysisRunId     String?

  @@index([modelKey, status, startedAt(sort: Desc)])
}

model ReadModelPointer {
  modelKey            String   @id
  currentGenerationId String
  switchedAt          DateTime @default(now())
}

model ReadModelState {
  modelKey            String    @id
  schemaVersion       Int
  status              String    @default("unknown")
  currentGenerationId String?
  sourceWatermarkAt   DateTime?
  lastStartedAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  expectedNextAt      DateTime?
  delayedAt           DateTime?
  staleAt             DateTime?
  rowCount            Int?
  policyHash          String?
  analyzerVersion     String?
  errorCode           String?
  errorSummary        String?
}
