datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// crawler と viewer は別々の pnpm ワークスペースパッケージであり、
// それぞれ独立した node_modules を持つため、
// output を指定しないデフォルトの生成先はどちらのパッケージからも解決できない。
// そのため output で生成先を明示的に指定している。
generator client {
  provider = "prisma-client-js"
  output   = "../crawler/generated/prisma"
}

generator viewerClient {
  provider = "prisma-client-js"
  output   = "../viewer/generated/prisma"
}

generator blockerClient {
  provider = "prisma-client-js"
  output   = "../blocker/generated/prisma"
}

generator analyzerClient {
  provider = "prisma-client-js"
  output   = "../analyzer/generated/prisma"
}

// ===== 新スキーマの前提 (DB 作り直し) =====
//
// 実体は prisma/baseline/ の raw SQL (baseline.sql、tweet-hash.sql または tweet-range.sql、functions.sql) で作る。
// この schema.prisma は Prisma Client の型生成と、`prisma migrate diff` による baseline との整合検査のために保つ。
// 列の並びは、8B 境界の列、4B、2B、1B、可変長の順にしてパディングを削っている (大きい表のみ)。
//
// Prisma の schema DSL では表現できず、raw SQL だけで管理するもの:
// - Tweet のパーティション (親表を通常の model として書く。HASH 版は複合 @@id、RANGE 版は id 単独の PK)
// - 部分インデックスと、式インデックス (Account 関連の recent tweets backfill、reply corpus、weekly review sample など)
// - トリガーと関数 (set_label_result、AccountActiveLabel の監査、ACL の集計表と weekly review sample の維持)
// - テーブルごとの fillfactor と autovacuum の設定、Observation.classificationSnapshot の lz4 圧縮
// - IDENTITY 列 (LabelDefinition.id、AnalysisWorkItem.id、AnalysisRun.id、AccountLabelChange.id)。
//   Prisma では `@default(autoincrement())` と書くが、実体は GENERATED ALWAYS AS IDENTITY。
// - AccountLabelChange.sourceLabelId の部分 unique インデックス
// - FK を張らない巨大・ホットな表 (Tweet、AccountLabelState、AccountActiveLabel、AccountClassificationLatest)。
//   Prisma は relation を書くと FK を作るため、これらの表には relation を書かない。
//   整合性は書き込み側と週次の孤児検査で担保する。
//
// Prisma が扱えるもの:
// - 複合 @@id、BigInt、`@db.SmallInt`、native enum、`@db.Timestamptz(3)`、BRIN インデックス
// - nullable な配列列: スキーマ上は `String[]` と書き、DB 列は NULL 可の `text[]` になる。
//   Prisma Client は NULL を空配列として読む。`[]` を書き込むと NULL でなく空配列 `{}` が入るため、
//   Tweet の空配列を NULL で保存する書き込みは raw SQL で行う。

model Account {
  id                           BigInt                @id
  accountCreatedAt             DateTime              @db.Timestamptz(3)
  firstSeenAt                  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime              @updatedAt @db.Timestamptz(3)
  followersCount               Int
  followingCount               Int
  tweetCount                   Int
  isBlueVerified               Boolean               @default(false)
  screenName                   String
  displayName                  String
  bio                          String?
  profileImageUrl              String?
  location                     String?
  url                          String?
  // verifiedType、professionalType、parodyCommentaryFanLabel は外部 API 由来の自由な文字列で、
  // 値の集合が閉じていないため enum にしない。
  verifiedType                 String?
  professionalType             String?
  parodyCommentaryFanLabel     String?
  crawlState                   AccountCrawlState?
  followerEdges                Follow[]              @relation("FollowerEdges")
  followeeEdges                Follow[]              @relation("FolloweeEdges")
  followStateChangesAsFollower FollowStateChange[]   @relation("FollowStateChangeFollower")
  followStateChangesAsFollowee FollowStateChange[]   @relation("FollowStateChangeFollowee")
  replyHijackEvidence          ReplyHijackEvidence[]
  blockerEdges                 Block[]               @relation("BlockerEdges")
  blockedEdges                 Block[]               @relation("BlockedEdges")
  blockActionsAsBlocker        BlockAction[]         @relation("BlockActionBlocker")
  blockActionsAsBlocked        BlockAction[]         @relation("BlockActionBlocked")
  blockOutboxEntriesAsBlocker  BlockOutboxEntry[]    @relation("BlockOutboxBlocker")
  blockOutboxEntriesAsBlocked  BlockOutboxEntry[]    @relation("BlockOutboxBlocked")

  // followersCount、tweetCount、lastCrawledAt、cover のインデックスは使用実績がないため作らない。
  // storage: fillfactor 80 (baseline.sql で設定する)。
}

enum RecentTweetsFetchStatus {
  success
  failed
}

// 更新頻度の高い列を Account から分離した表。
// lastRecentTweetsAttemptedAt の更新だけが HOT にならず、他の列の更新は HOT になる。
// backfill 候補 selector 用の部分インデックス (WHERE lastRecentTweetsAttemptedAt IS NULL) は、
// baseline.sql の raw SQL で管理する。
// storage は fillfactor 70。
model AccountCrawlState {
  accountId                   BigInt                   @id
  account                     Account                  @relation(fields: [accountId], references: [id])
  lastCrawledAt               DateTime                 @default(now()) @db.Timestamptz(3)
  lastRecentTweetsAttemptedAt DateTime?                @db.Timestamptz(3)
  lastRecentTweetsFetchedAt   DateTime?                @db.Timestamptz(3)
  recentTweetsFetchStatus     RecentTweetsFetchStatus?
}

// パーティション親表。この schema は HASH(accountId) x 32 版 (複合 PK) を表す。
// RANGE(id) 版 (tweet-range.sql) では PK が id 単独になる。どちらか一方だけを適用する。
// Account への FK は張らない (INSERT ごとの親行ロックと検証コストを避ける)。relation を書かないのはそのため。
// quoteCount、retweetedTweetId、quotedTweetId、source は参照がないため持たない。
// expandedUrls と cardDestinationUrls は、空配列を NULL で保存する (DB 列は NULL 可、既定値なし)。
// 部分インデックス (reply corpus の collectedAt DESC, id DESC WHERE isReply) は raw SQL で管理する。
// storage: fillfactor 90、autovacuum の insert 閾値を引き下げる (tweet-*.sql で設定する)。
model Tweet {
  id                           BigInt
  accountId                    BigInt
  createdAt                    DateTime @db.Timestamptz(3)
  collectedAt                  DateTime @default(now()) @db.Timestamptz(3)
  inReplyToTweetId             BigInt?
  conversationId               BigInt?
  quotedTweetAuthorId          BigInt?
  retweetCount                 Int
  likeCount                    Int
  replyCount                   Int
  foreignVideoSourceCount      Int?
  isReply                      Boolean  @default(false)
  isAuthorReply                Boolean  @default(false)
  isRetweet                    Boolean  @default(false)
  isPromoted                   Boolean  @default(false)
  isPaidPromotion              Boolean  @default(false)
  // この列が存在する前に収集された行は Card 自体を評価していないため、
  // デフォルトを true ではなく false にして未評価の状態と実際の評価結果を区別している。
  cardDestinationUrlsEvaluated Boolean  @default(false)
  hasMedia                     Boolean?
  // この列が存在する前に収集された行は判定自体が行われていないため、
  // デフォルトを false ではなく null にして未評価の状態と実際の判定結果を区別している。
  hasAiGeneratedMedia          Boolean?
  // hasAiGeneratedMedia と同じ理由で、未評価行を区別するためデフォルトを設定せず null のままにしている。
  quotedTweetHasVideo          Boolean?
  aiGeneratedDetectionSource   String?
  expandedUrls                 String[]
  cardDestinationUrls          String[]
  fullText                     String

  @@id([accountId, id])
  @@index([accountId, createdAt])
}

// id は再利用しない。AccountLabelState.versions の添字を兼ねるため、削除せず retiredAt で廃止する。
// 実体は GENERATED ALWAYS AS IDENTITY (smallint)。
model LabelDefinition {
  id                   Int                @id @default(autoincrement()) @db.SmallInt
  currentRuleVersionNo Int?               @db.SmallInt
  retiredAt            DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  key                  String             @unique
  description          String
  ruleVersions         LabelRuleVersion[]
  blockActions         BlockAction[]
  blockOutboxEntries   BlockOutboxEntry[]
}

// versionNo は 1 始まりで、0 は予約値 (AccountLabelState.versions で符号付きに使うため、0 と -0 を区別できない)。
// 0 を許さない CHECK 制約は baseline.sql で付ける。
model LabelRuleVersion {
  labelDefinitionId Int             @db.SmallInt
  labelDefinition   LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  versionNo         Int             @db.SmallInt
  ruleVersion       String

  @@id([labelDefinitionId, versionNo])
  @@unique([labelDefinitionId, ruleVersion])
}

// アカウントごとの評価状態。ラベルの true/false/評価不能/未評価をここで持ち、
// 書き込みは関数 set_label_result (functions.sql) だけに閉じる。FK は張らない。
// versions の添字は LabelDefinition.id (1 始まり)。
//   0 または配列外 = 未評価、正 = 評価済みの versionNo、負 = -versionNo で評価不能。
//   評価済みで AccountActiveLabel に行がある = true、行がない = false。
// rev は書き込みのたびに 1 増える。評価入力を読んだ時点の rev と比べて競合を防ぐ (CAS)。
// versions は NOT NULL とするため、Prisma 側では空配列を既定値にしている (DB 側の既定値も空配列)。
// storage: fillfactor 75、autovacuum_vacuum_scale_factor 0.02 (baseline.sql で設定する)。
model AccountLabelState {
  accountId   BigInt   @id
  evaluatedAt DateTime @db.Timestamptz(3)
  rev         Int      @default(0)
  versions    Int[]    @default([]) @db.SmallInt
}

// value = true の行のみを持つ。FK は張らない。書き込みは set_label_result だけが行い、
// INSERT/UPDATE/DELETE は監査トリガー (functions.sql) が AccountLabelChange へ記録する。
// sourceKind は 0 = legacy、1 = crawl、2 = relabel。
// インデックスは Prisma で表現できるため schema に宣言している。
model AccountActiveLabel {
  accountId         BigInt
  labeledAt         DateTime @db.Timestamptz(3)
  confidence        Float
  labelDefinitionId Int      @db.SmallInt
  ruleVersionNo     Int      @db.SmallInt
  sourceKind        Int      @default(0) @db.SmallInt
  method            String
  reason            String
  sourceId          String?
  sourceUsername    String?

  @@id([accountId, labelDefinitionId])
  @@index([labelDefinitionId, ruleVersionNo, confidence(sort: Desc), accountId])
}

/// storage-guard が計測したホストファイルシステムの空き容量・使用率を保持する単一行テーブル。
/// relabel の fail-closed circuit breaker が読む唯一の情報源であり、書き込みは storage-guard
/// service のみが行う。
model StorageCapacityState {
  id             String   @id
  availableGib   Float
  usedPercent    Int
  measuredAt     DateTime @db.Timestamptz(3)
  // circuit breaker の hysteresis 判定結果 (blocked かどうか) の永続化。
  // プロセス内メモリだけで持つと relabeler 再起動のたびに ok 相当から
  // 再判定してしまい、blocked から回復しきい値に届く前の中間的な値を
  // 再起動直後の最初の計測として受け取った際に hysteresis を経ずに
  // 再開してしまうため、storage-guard の書き込みを跨いで保持する。
  relabelBlocked Boolean  @default(false)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

model WeeklyAnalysisRun {
  id                String    @id @default(cuid())
  startedAt         DateTime  @db.Timestamptz(3)
  lastHeartbeatAt   DateTime  @db.Timestamptz(3)
  finishedAt        DateTime? @db.Timestamptz(3)
  staleAfterAt      DateTime? @db.Timestamptz(3)
  status            String
  currentPhase      String?
  errorMessage      String?
  pullRequestNumber Int?
  pullRequestUrl    String?
  sampledAccountIds Json
  findings          String?
  commitSha         String?
  targetFrom        DateTime? @db.Timestamptz(3)
  targetTo          DateTime? @db.Timestamptz(3)
  analysisVersion   String?
  modelIdentity     String?
  toolIdentity      String?
  policyHash        String?
  reviewPlan        Json?
  structuredOutput  Json?

  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  BigInt
  follower    Account  @relation("FollowerEdges", fields: [followerId], references: [id])
  followeeId  BigInt
  followee    Account  @relation("FolloweeEdges", fields: [followeeId], references: [id])
  firstSeenAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

model FollowStateChange {
  id         String   @id @default(cuid())
  followerId BigInt
  follower   Account  @relation("FollowStateChangeFollower", fields: [followerId], references: [id])
  followeeId BigInt
  followee   Account  @relation("FollowStateChangeFollowee", fields: [followeeId], references: [id])
  changeType String
  observedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([followerId, observedAt(sort: Desc)])
  @@index([followeeId, observedAt(sort: Desc)])
}

model ReplyHijackEvidence {
  id                String   @id @default(cuid())
  accountId         BigInt
  account           Account  @relation(fields: [accountId], references: [id])
  targetTweetId     BigInt
  ruleVersion       String
  observedAt        DateTime @updatedAt @db.Timestamptz(3)
  swarmSize         Int
  averageSimilarity Float
  spanHours         Float
  replyTweetIds     BigInt[] @default([])

  @@unique([accountId, targetTweetId, ruleVersion])
  @@index([targetTweetId])
}

model Block {
  id                      String    @id @default(cuid())
  blockerId               BigInt
  blocker                 Account   @relation("BlockerEdges", fields: [blockerId], references: [id])
  blockedId               BigInt
  blocked                 Account   @relation("BlockedEdges", fields: [blockedId], references: [id])
  firstSeenAt             DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt              DateTime  @default(now()) @db.Timestamptz(3)
  // 完全同期で対象が存在しない場合のみ論理状態を進める。物理削除はしない。
  status                  String    @default("active")
  lastCheckedAt           DateTime  @default(now()) @db.Timestamptz(3)
  missingSinceAt          DateTime? @db.Timestamptz(3)
  resolvedAt              DateTime? @db.Timestamptz(3)
  consecutiveMissingCount Int       @default(0)
  sourceKind              String    @default("legacy")
  sourceId                String?

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@index([status, lastCheckedAt(sort: Desc)])
}

model CrawlRun {
  id                      String                   @id @default(cuid())
  startedAt               DateTime                 @db.Timestamptz(3)
  lastHeartbeatAt         DateTime                 @db.Timestamptz(3)
  finishedAt              DateTime?                @db.Timestamptz(3)
  status                  String
  currentUsername         String?
  currentAccountStartedAt DateTime?                @db.Timestamptz(3)
  staleAfterAt            DateTime?                @db.Timestamptz(3)
  accountRuns             CrawlAccountRun[]
  checkpoints             CrawlAccountCheckpoint[]
  accountLabelRuns        CrawlAccountLabelRun[]
  authorCheckpoints       CrawlAuthorCheckpoint[]
  labelEvidenceEpoch      LabelEvidenceEpoch?

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

// CrawlRun の terminal 確定時に crawler が publish する不変の観測単位。
// WorkItem の retry や再 enqueue とは独立して detector lifecycle の identity を保つ。
model LabelEvidenceEpoch {
  id                String   @id @default(cuid())
  crawlRunId        String   @unique
  crawlRun          CrawlRun @relation(fields: [crawlRunId], references: [id])
  sourceWatermarkAt DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([sourceWatermarkAt(sort: Desc)])
}

model CrawlAccountRun {
  id                    String    @id @default(cuid())
  crawlRunId            String
  crawlRun              CrawlRun  @relation(fields: [crawlRunId], references: [id])
  username              String
  startedAt             DateTime  @db.Timestamptz(3)
  finishedAt            DateTime? @db.Timestamptz(3)
  status                String
  recommendedCount      Int       @default(0)
  followingCount        Int       @default(0)
  trendingCount         Int       @default(0)
  replyCount            Int       @default(0)
  profileCount          Int       @default(0)
  labelsAppliedCount    Int       @default(0)
  parentTweetFetchCount Int       @default(0)
  followingSynced       Boolean   @default(false)
  followersSynced       Boolean   @default(false)
  blocksSynced          Boolean   @default(false)
  warnings              Json      @default("[]")
  errorMessage          String?
  /// crawler イメージに埋め込まれた APPLICATION_VERSION (Docker のビルド引数)。
  /// 値が取得できない場合は "unknown" になる。
  /// この行を最終的に確定させたビルドを表しており、
  /// 個々の warning を発生させたビルドは warnings 内の各要素が持つ appVersion を参照する。
  appVersion            String    @default("unknown")
  classificationStatus  String    @default("unknown")

  @@index([crawlRunId])
  @@index([startedAt])
  @@index([crawlRunId, username, startedAt(sort: Desc), id(sort: Desc)])
}

model CrawlAccountCheckpoint {
  id          String   @id @default(cuid())
  crawlRunId  String
  crawlRun    CrawlRun @relation(fields: [crawlRunId], references: [id])
  username    String
  phase       String
  data        Json
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([crawlRunId, username, phase])
  @@index([crawlRunId, username])
}

model CrawlAccountLabelRun {
  id                String   @id @default(cuid())
  crawlRunId        String
  crawlRun          CrawlRun @relation(fields: [crawlRunId], references: [id])
  username          String
  accountId         BigInt
  labelDefinitionId Int      @db.SmallInt
  method            String
  ruleVersion       String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([crawlRunId, username, accountId, labelDefinitionId, method, ruleVersion])
}

model CrawlAuthorCheckpoint {
  id                                 String   @id @default(cuid())
  crawlRunId                         String
  crawlRun                           CrawlRun @relation(fields: [crawlRunId], references: [id])
  username                           String
  authorId                           BigInt
  status                             String
  profileCount                       Int      @default(0)
  labelsAppliedCount                 Int      @default(0)
  warnings                           Json     @default("[]")
  durationMs                         Int?
  retryWaitMs                        Int?
  followSampleStatus                 String?
  followSampleRequestCount           Int      @default(0)
  followSampleRateLimitRemaining     Int?
  followSampleRateLimitReset         Int?
  parentTweetFetchRequestCount       Int      @default(0)
  parentTweetFetchRateLimitRemaining Int?
  parentTweetFetchRateLimitReset     Int?
  appVersion                         String   @default("unknown")
  completedAt                        DateTime @default(now()) @db.Timestamptz(3)

  @@unique([crawlRunId, username, authorId])
  @@index([crawlRunId, username])
}

// activeLabelKeys (text[]) への GIN index は既定の array ops で表現できるため、schema にも宣言している。
// trigram の GIN index は Prisma で表現できないため、baseline.sql の raw SQL で作成する。
model AccountSummaryLatest {
  accountId                   BigInt    @id
  normalizedScreenName        String
  normalizedDisplayName       String
  searchDocument              String
  profileObservedAt           DateTime  @db.Timestamptz(3)
  activeLabelKeys             String[]
  activeLabelCount            Int
  lastClassificationChangedAt DateTime? @db.Timestamptz(3)
  classificationObservedAt    DateTime? @db.Timestamptz(3)
  activeFindingCount          Int       @default(0)
  highestFindingSeverity      String?
  findingObservedAt           DateTime? @db.Timestamptz(3)
  updatedAt                   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([lastClassificationChangedAt(sort: Desc), accountId])
  @@index([highestFindingSeverity, activeFindingCount, accountId])
  @@index([normalizedScreenName])
  @@index([activeLabelKeys], type: Gin, map: "AccountSummaryLatest_activeLabelKeys_gin_idx")
}

// AccountSummaryLatest.activeLabelCount が 0 ⇔ 正 を跨いだ行だけトリガーで増減させ、
// 少なくとも1つ true ラベルを持つ distinct account 数を O(1) で保持する。
// 維持方法は baseline.sql のトリガー定義を参照する。
model LabeledAccountCounter {
  id              String   @id
  labeledAccounts Int
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

// キーは bigint と smallint で、FK は張らない。
// 列は 8B 境界、4B、2B、1B、可変長の順に並べる。
// (labelDefinitionId, value, accountId) のインデックスは作らない。
// weekly review の sample 用の部分インデックスと、集計表を維持するトリガーは raw SQL で管理する。
model AccountClassificationLatest {
  accountId           BigInt
  observedAt          DateTime  @db.Timestamptz(3)
  labeledAt           DateTime? @db.Timestamptz(3)
  confidence          Float
  labelDefinitionId   Int       @db.SmallInt
  value               Boolean
  evaluable           Boolean   @default(false)
  reason              String
  method              String
  ruleVersion         String
  sourceObservationId String?

  @@id([accountId, labelDefinitionId])
}

// weekly review の random baseline sampling 用に、labelDefinitionId/value/bucket
// 単位で eligible (evaluable=true AND labeledAt IS NOT NULL) な行数を集計する。
// 維持方法は baseline.sql のトリガー定義を参照する。
model WeeklyReviewSampleBucketCount {
  labelDefinitionId Int     @db.SmallInt
  value             Boolean
  bucket            Int
  count             Int     @default(0)

  @@id([labelDefinitionId, value, bucket])
}

model AccountClassificationValueCount {
  labelDefinitionId Int     @db.SmallInt
  value             Boolean
  count             Int     @default(0)
  confidenceSum     Float   @default(0)

  @@id([labelDefinitionId, value])
}

model AccountClassificationConfidenceBucketCount {
  labelDefinitionId Int @db.SmallInt
  confidenceBucket  Int
  count             Int @default(0)

  @@id([labelDefinitionId, confidenceBucket])
}

model AccountClassificationRuleVersionCount {
  labelDefinitionId Int    @db.SmallInt
  ruleVersion       String
  count             Int    @default(0)

  @@id([labelDefinitionId, ruleVersion])
}

model AccountClassificationFreshnessBucket {
  labelDefinitionId Int      @db.SmallInt
  observedAtBucket  DateTime @db.Timestamptz(3)
  count             Int      @default(0)

  @@id([labelDefinitionId, observedAtBucket])
}

model AccountClassificationReasonCount {
  labelDefinitionId Int    @db.SmallInt
  reason            String
  count             Int    @default(0)

  @@id([labelDefinitionId, reason])
}

// classificationSnapshot は lz4 圧縮にする (baseline.sql の ALTER TABLE で設定する)。
model AccountClassificationObservation {
  observedAt             DateTime @db.Timestamptz(3)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  accountId              BigInt
  labelCount             Int
  // crawl 経路でのみ設定する。relabel は Observation を作らないため常に null。
  // サポートするバージョンは analyzer 側の分岐ロジックが判定する。
  snapshotVersion        Int?
  id                     String   @id @default(cuid())
  crawlRunId             String?
  username               String?
  // labelDefinitionId・value・confidence・reason・method・ruleVersion・evaluable・labeledAt を
  // 持つ不変な配列。crawl 実行時点の評価結果をその場で確定するため、
  // 後続の relabel による上書きの影響を受けない。
  classificationSnapshot Json?

  @@index([accountId, observedAt(sort: Desc)])
}

model ReadModelBootstrap {
  modelKey       String    @id
  status         String    @default("pending")
  cursor         String?
  processedCount Int       @default(0)
  startedAt      DateTime? @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  errorSummary   String?
}

model BlockRun {
  id              String            @id @default(cuid())
  startedAt       DateTime          @db.Timestamptz(3)
  lastHeartbeatAt DateTime          @db.Timestamptz(3)
  finishedAt      DateTime?         @db.Timestamptz(3)
  status          String
  staleAfterAt    DateTime?         @db.Timestamptz(3)
  accountRuns     BlockAccountRun[]

  @@index([startedAt])
  @@index([status, startedAt(sort: Desc), id(sort: Desc)])
}

model BlockAccountRun {
  id              String             @id @default(cuid())
  blockRunId      String
  blockRun        BlockRun           @relation(fields: [blockRunId], references: [id])
  username        String
  startedAt       DateTime           @db.Timestamptz(3)
  finishedAt      DateTime?          @db.Timestamptz(3)
  status          String
  candidatesCount Int                @default(0)
  blockedCount    Int                @default(0)
  failedCount     Int                @default(0)
  errorMessage    String?
  actions         BlockAction[]
  outboxEntries   BlockOutboxEntry[]

  @@index([blockRunId])
  @@index([blockRunId, username, startedAt(sort: Desc), id(sort: Desc)])
  @@index([errorMessage, startedAt(sort: Desc), id(sort: Desc)])
}

model BlockAction {
  id                String            @id @default(cuid())
  blockAccountRunId String
  blockAccountRun   BlockAccountRun   @relation(fields: [blockAccountRunId], references: [id])
  blockerId         BigInt
  blocker           Account           @relation("BlockActionBlocker", fields: [blockerId], references: [id])
  blockedId         BigInt
  blocked           Account           @relation("BlockActionBlocked", fields: [blockedId], references: [id])
  labelDefinitionId Int               @db.SmallInt
  labelDefinition   LabelDefinition   @relation(fields: [labelDefinitionId], references: [id])
  confidence        Float
  result            String
  errorMessage      String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  outboxEntryId     String?           @unique
  outboxEntry       BlockOutboxEntry? @relation(fields: [outboxEntryId], references: [id])

  // selectBlockCandidates が「過去に result = 'success' の BlockAction が存在するか」を
  // (blockerId, blockedId) 単位で調べるためのインデックス。
  @@index([blockerId, blockedId, result])
  @@index([blockAccountRunId])
}

// createBlock (remote) 実行前に durable な intent を作ることで、DB 障害でどの段階が失敗しても直前に確定した状態が残るようにする。
// (blockerId, blockedId) の一意制約により同一ペアの outbox entry は常に 1 件に保たれ、中断や再選定後の再開は既存行の再利用で行う。
model BlockOutboxEntry {
  id                  String          @id @default(cuid())
  blockAccountRunId   String
  blockAccountRun     BlockAccountRun @relation(fields: [blockAccountRunId], references: [id])
  blockerId           BigInt
  blocker             Account         @relation("BlockOutboxBlocker", fields: [blockerId], references: [id])
  blockedId           BigInt
  blocked             Account         @relation("BlockOutboxBlocked", fields: [blockedId], references: [id])
  labelDefinitionId   Int             @db.SmallInt
  labelDefinition     LabelDefinition @relation(fields: [labelDefinitionId], references: [id])
  confidence          Float
  status              String
  remoteSkipCount     Int             @default(0)
  lastRemoteSkippedAt DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  remoteSucceededAt   DateTime?       @db.Timestamptz(3)
  localPersistedAt    DateTime?       @db.Timestamptz(3)
  reconciledAt        DateTime?       @db.Timestamptz(3)
  actions             BlockAction[]

  @@unique([blockerId, blockedId])
  @@index([status, createdAt])
}

// analyzer が処理する耐久キュー。at-least-once を前提とし、
// exactly-once は装わない。冪等性は出力側の unique constraint で担保する。
// 未処理・実行中・dead の行だけを持ち、完了した論理キーは AnalysisWorkItemDone へ移す。
// storage: fillfactor 50 (baseline.sql で設定する)。
model AnalysisWorkItem {
  availableAt      DateTime  @default(now()) @db.Timestamptz(3)
  leaseExpiresAt   DateTime? @db.Timestamptz(3)
  // account_relabel 専用: lease 中に新しい変更要求が来たことを示すマーカー。
  // complete 時にこれが設定されていれば完了にせず queued へ戻す(他 kind では未使用)。
  staleRequestedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  id               Int       @id @default(autoincrement())
  priority         Int       @default(0)
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(5)
  kind             String
  triggerType      String
  triggerId        String
  status           String    @default("queued")
  leaseOwner       String?
  dependencyKey    String?
  lastErrorCode    String?
  lastErrorSummary String?

  // 同じ完了イベントを複数回通知しても WorkItem を重複生成しないための論理一意キー。
  @@unique([kind, triggerType, triggerId])
  // claim 用の部分インデックス (status, availableAt, priority) は baseline.sql で管理する。
}

// 完了した論理キーの台帳。30 日保持する。
// 保持期間内は、同じ論理キーが再びキューに入るのを防ぐ。
model AnalysisWorkItemDone {
  completedAt  DateTime @default(now()) @db.Timestamptz(3)
  // 完了した WorkItem の enqueue 時刻と id・試行回数。
  // キュー表から消えた後も、AnalysisRun の参照と post-completion の再実行で元の値を復元するために持つ。
  createdAt    DateTime @db.Timestamptz(3)
  workItemId   Int
  attemptCount Int
  kind         String
  triggerType  String
  triggerId    String

  @@id([kind, triggerType, triggerId])
  @@index([completedAt])
  @@index([workItemId])
}

// workItemId は AnalysisWorkItem への参照だが、WorkItem は完了後に消えるため FK を張らない。
model AnalysisRun {
  startedAt     DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime? @db.Timestamptz(3)
  id            Int       @id @default(autoincrement())
  workItemId    Int?
  attemptNumber Int
  status        String
  errorCode     String?
  errorSummary  String?

  @@index([workItemId, startedAt(sort: Desc)])
}

// account_relabel producer の incremental scan 位置を永続化する singleton テーブル。
// 1 行だけを持ち、id は常に固定値 "singleton" を使う。
model RelabelScanCursor {
  id                   String   @id @default("singleton")
  lastScannedAccountId BigInt?
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
}

model OperationCycle {
  id                String           @id @default(cuid())
  kind              String
  sourceType        String
  sourceId          String
  triggeredAt       DateTime         @db.Timestamptz(3)
  expectedAt        DateTime?        @db.Timestamptz(3)
  startedAt         DateTime?        @db.Timestamptz(3)
  finishedAt        DateTime?        @db.Timestamptz(3)
  status            String           @default("scheduled")
  attentionRequired Boolean          @default(false)
  currentStageKey   String?
  sourceWatermarkAt DateTime?        @db.Timestamptz(3)
  modelVersion      String
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  stages            OperationStage[]

  @@unique([sourceType, sourceId])
  @@index([kind, startedAt(sort: Desc), id(sort: Desc)])
  @@index([kind, triggeredAt(sort: Desc), id(sort: Desc)])
  @@index([attentionRequired, status])
}

model OperationStage {
  id            String         @id @default(cuid())
  cycleId       String
  cycle         OperationCycle @relation(fields: [cycleId], references: [id])
  stageKey      String
  sequence      Int
  requiredness  String
  status        String         @default("waiting")
  attemptCount  Int            @default(0)
  sourceType    String?
  sourceId      String?
  expectedAt    DateTime?      @db.Timestamptz(3)
  delayedAt     DateTime?      @db.Timestamptz(3)
  staleAt       DateTime?      @db.Timestamptz(3)
  startedAt     DateTime?      @db.Timestamptz(3)
  heartbeatAt   DateTime?      @db.Timestamptz(3)
  finishedAt    DateTime?      @db.Timestamptz(3)
  counters      Json           @default("{}")
  errorCode     String?
  errorSummary  String?
  analysisRunId Int?

  @@unique([cycleId, stageKey])
  @@index([cycleId, sequence])
}

model OperationalIssue {
  id                  String                       @id @default(cuid())
  component           String
  type                String
  fingerprint         String
  status              String                       @default("active")
  severity            String
  firstDetectedAt     DateTime                     @default(now()) @db.Timestamptz(3)
  lastDetectedAt      DateTime                     @default(now()) @db.Timestamptz(3)
  resolvedAt          DateTime?                    @db.Timestamptz(3)
  currentOccurrenceId String?
  sourceCycleId       String?
  sourceStageId       String?
  occurrences         OperationalIssueOccurrence[]

  @@unique([fingerprint])
  @@index([status, severity, lastDetectedAt(sort: Desc), id(sort: Desc)])
}

model OperationalIssueOccurrence {
  id              String           @id @default(cuid())
  issueId         String
  issue           OperationalIssue @relation(fields: [issueId], references: [id])
  observedAt      DateTime         @default(now()) @db.Timestamptz(3)
  stateTransition String
  severity        String
  sourceType      String
  sourceId        String
  measurements    Json             @default("{}")
  observationKey  String

  @@unique([issueId, observationKey])
  @@index([issueId, observedAt(sort: Desc), id(sort: Desc)])
}

model ReviewFinding {
  id                    String                    @id @default(cuid())
  fingerprint           String
  identityVersion       Int
  episodeNumber         Int                       @default(1)
  type                  String
  primaryScopeType      String
  primaryScopeId        String
  status                String                    @default("active")
  currentSeverity       String
  maximumSeverity       String
  firstDetectedAt       DateTime                  @default(now()) @db.Timestamptz(3)
  lastDetectedAt        DateTime                  @default(now()) @db.Timestamptz(3)
  resolvedAt            DateTime?                 @db.Timestamptz(3)
  recurrenceCount       Int                       @default(0)
  previousFindingId     String?
  supersededByFindingId String?
  currentOccurrenceId   String?
  occurrences           ReviewFindingOccurrence[]
  evidences             FindingEvidence[]
  entityLinks           FindingEntityLink[]

  @@unique([fingerprint, identityVersion, episodeNumber])
  @@index([status, currentSeverity, lastDetectedAt(sort: Desc), id(sort: Desc)])
  @@index([primaryScopeType, primaryScopeId])
}

model ReviewFindingOccurrence {
  id                 String        @id @default(cuid())
  findingId          String
  finding            ReviewFinding @relation(fields: [findingId], references: [id])
  observedAt         DateTime      @default(now()) @db.Timestamptz(3)
  // observedAt は analyzer がこの Occurrence を書き込んだ処理時刻であり、lifecycle の
  // クールダウン判定に使う。crawl/weekly review の元データ自体の時刻とは異なるため、
  // AccountSummary 側で sourceWatermarkAt と比較する際はこちらを使う。
  sourceObservedAt   DateTime      @db.Timestamptz(3)
  stateTransition    String
  severity           String
  sourceType         String
  sourceId           String
  observedValue      Float?
  baselineValue      Float?
  absoluteDifference Float?
  relativeDifference Float?
  affectedCount      Int?
  totalCount         Int?
  affectedRatio      Float?
  consecutiveCount   Int           @default(0)
  confidence         Float?
  thresholds         Json          @default("{}")
  measurements       Json          @default("{}")
  policyHash         String
  detectorVersion    String
  observationKey     String

  @@unique([findingId, observationKey])
  @@index([findingId, observedAt(sort: Desc), id(sort: Desc)])
  @@index([findingId, sourceObservedAt(sort: Desc), id(sort: Desc)])
}

model FindingEvidence {
  id                    String        @id @default(cuid())
  findingId             String
  finding               ReviewFinding @relation(fields: [findingId], references: [id])
  kind                  String
  schemaVersion         Int
  redactionVersion      Int
  sampleStrategyVersion String?
  payload               Json
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)

  @@index([findingId, kind, createdAt(sort: Desc)])
}

// Raw Analysis や大容量 artifact を遅延取得できるよう Finding 本体から分離する。
// 1 件 1 MiB を超える内容は書き込み時に切り詰め、isTruncated を立てる。
model FindingRawArtifact {
  id          String   @id @default(cuid())
  findingId   String
  kind        String
  content     String
  isTruncated Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([findingId, kind])
}

model FindingEntityLink {
  id         String        @id @default(cuid())
  findingId  String
  finding    ReviewFinding @relation(fields: [findingId], references: [id])
  entityType String
  entityId   String

  @@unique([findingId, entityType, entityId])
  @@index([entityType, entityId])
}

model DetectionPolicyVersion {
  id            String   @id @default(cuid())
  policyVersion String   @unique
  contentHash   String
  schemaVersion Int
  content       Json
  loadedAt      DateTime @default(now()) @db.Timestamptz(3)
}

// active 化前の候補を含む detector 評価結果。通常の Review 一覧には表示しない。
model DetectorEvaluation {
  id              String   @id @default(cuid())
  detectorType    String
  fingerprint     String
  identityVersion Int
  // 同一観測イベント (例: 同じ CrawlRun) の at-least-once retry で
  // DetectorEvaluation が重複しないための論理一意キー。
  sourceId        String
  evaluatedAt     DateTime @default(now()) @db.Timestamptz(3)
  isShadow        Boolean  @default(false)
  result          Json
  policyHash      String

  @@unique([fingerprint, identityVersion, sourceId, isShadow])
  @@index([detectorType, fingerprint, evaluatedAt(sort: Desc)])
  @@index([isShadow, evaluatedAt(sort: Desc)])
  @@index([fingerprint, identityVersion, evaluatedAt(sort: Desc)])
}

model PolicyBacktestRun {
  id                  String                  @id @default(cuid())
  candidatePolicyHash String
  baselinePolicyHash  String
  targetFrom          DateTime                @db.Timestamptz(3)
  targetTo            DateTime                @db.Timestamptz(3)
  startedAt           DateTime                @default(now()) @db.Timestamptz(3)
  finishedAt          DateTime?               @db.Timestamptz(3)
  status              String                  @default("running")
  summary             Json                    @default("{}")
  findings            PolicyBacktestFinding[]
}

model PolicyBacktestFinding {
  id          String            @id @default(cuid())
  runId       String
  run         PolicyBacktestRun @relation(fields: [runId], references: [id])
  fingerprint String
  severity    String
  diffKind    String
  detail      Json              @default("{}")

  @@index([runId, diffKind])
}

model LabelMetricSnapshot {
  id                      String   @id @default(cuid())
  sourceCrawlRunId        String?
  triggerWorkItemId       Int
  labelDefinitionId       Int      @db.SmallInt
  observedAt              DateTime @db.Timestamptz(3)
  generatedAt             DateTime @default(now()) @db.Timestamptz(3)
  sourceWatermarkAt       DateTime @db.Timestamptz(3)
  populationCount         Int      @default(0)
  evaluatedCount          Int
  trueCount               Int
  prevalence              Float
  coverage                Float    @default(0)
  currentCount            Int      @default(0)
  delayedCount            Int      @default(0)
  staleCount              Int      @default(0)
  unknownCount            Int      @default(0)
  staleRatio              Float    @default(0)
  trueConfidenceAverage   Float?
  falseConfidenceAverage  Float?
  confidenceBuckets       Json     @default("{}")
  reasonDistribution      Json     @default("{}")
  ruleVersionDistribution Json     @default("{}")
  completeness            String
  policyHash              String
  analyzerVersion         String
  analysisRunId           Int?

  @@unique([triggerWorkItemId, labelDefinitionId])
  @@index([labelDefinitionId, observedAt(sort: Desc), id(sort: Desc)])
}

model LabelMetricDaily {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  labelDefinitionId  Int      @db.SmallInt
  evaluatedCount     Int
  trueCount          Int
  prevalence         Float
  confidenceBuckets  Json     @default("{}")
  reasonDistribution Json     @default("{}")
  // この行の値が採用された元 LabelMetricSnapshot.observedAt。
  // 遅延して実行された backlog 分の build が、それより新しい observedAt を
  // 採用済みの行を古い値へ巻き戻すのを防ぐ判定にのみ使う。
  sourceObservedAt   DateTime @db.Timestamptz(3)

  @@unique([date, labelDefinitionId])
  @@index([labelDefinitionId, date(sort: Desc)])
}

enum AccountLabelChangeType {
  added
  removed
  unevaluable
}

// 追記のみの表。AccountActiveLabel の監査トリガーが書く。
// removed は評価が false になった遷移、unevaluable は true から評価不能になった遷移を表す。
// sourceLabelId は analyzer の再処理を冪等にするキーで、値があるときだけ一意にする。
// その部分 unique インデックスは Prisma で表現できないため baseline.sql の raw SQL で管理する。
// 同一ミリ秒に複数回遷移しても各 transition を別イベントとして保持する。
// changedAt の BRIN は、追記順と時刻が一致するため効く。
model AccountLabelChange {
  accountId          BigInt
  changedAt          DateTime               @default(now()) @db.Timestamptz(3)
  previousConfidence Float?
  newConfidence      Float?
  id                 Int                    @id @default(autoincrement())
  changeType         AccountLabelChangeType
  labelDefinitionId  Int                    @db.SmallInt
  previousValue      Boolean?
  newValue           Boolean?
  sourceId           String?
  sourceLabelId      String?
  previousReason     String?
  newReason          String?

  @@index([accountId, changedAt(sort: Desc)])
  @@index([changedAt], type: Brin)
}

model LabelSummaryCurrent {
  generationId           String
  labelDefinitionId      Int      @db.SmallInt
  latestSnapshotId       String?
  evaluatedCount         Int
  trueCount              Int
  populationCount        Int      @default(0)
  coverage               Float    @default(0)
  prevalence             Float
  previousRunDelta       Float?
  dayDelta               Float?
  weekDelta              Float?
  confidenceShift        Json     @default("{}")
  reasonShift            Json     @default("{}")
  activeFindingCount     Int      @default(0)
  highestFindingSeverity String?
  qualityStatus          String
  sourceWatermarkAt      DateTime @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  @@id([generationId, labelDefinitionId])
  @@index([generationId, qualityStatus])
}

model BlockRelationCurrent {
  generationId                String
  blockId                     String
  normalizedBlockerScreenName String
  normalizedBlockedScreenName String
  status                      String
  statusChangedAt             DateTime @db.Timestamptz(3)
  activeFindingCount          Int      @default(0)
  highestFindingSeverity      String?
  sourceWatermarkAt           DateTime @db.Timestamptz(3)

  @@id([generationId, blockId])
  @@index([generationId, status, statusChangedAt(sort: Desc), blockId])
}

model BlockStateChange {
  id         String   @id @default(cuid())
  blockId    String
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now()) @db.Timestamptz(3)
  sourceId   String?

  @@index([blockId, changedAt(sort: Desc), id(sort: Desc)])
}

// Overview の Attention Queue 用に OperationalIssue と ReviewFinding を正規化する
// 読み取りモデル。正本ではなく、独自ライフサイクルを持たない (元データへの参照必須)。
model AttentionItemCurrent {
  generationId String
  sourceType   String
  sourceId     String
  category     String
  priority     Int
  severity     String
  summary      String
  impact       Json     @default("{}")
  detectedAt   DateTime @db.Timestamptz(3)
  freshness    String
  detailHref   String

  @@id([generationId, sourceType, sourceId])
  @@index([generationId, priority])
}

model OverviewSnapshot {
  id                String   @id @default(cuid())
  // ReadModelGeneration.id と 1:1 に対応させ、Pointer 経由の原子的公開に乗せるためのキー。
  generationId      String   @unique
  schemaVersion     Int
  generatedAt       DateTime @default(now()) @db.Timestamptz(3)
  sourceWatermarkAt DateTime @db.Timestamptz(3)
  operationalStatus String
  qualityStatus     String
  payload           Json
  analysisRunId     Int?

  @@index([generatedAt(sort: Desc)])
}

model ReadModelGeneration {
  id                String    @id @default(cuid())
  modelKey          String
  schemaVersion     Int
  status            String    @default("building")
  sourceWatermarkAt DateTime? @db.Timestamptz(3)
  startedAt         DateTime  @default(now()) @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
