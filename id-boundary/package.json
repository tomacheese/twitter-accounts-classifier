{
  "name": "id-boundary",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "run-p lint typecheck test"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.13.1",
    "@types/node": "26.6.11",
    "eslint": "9.39.5",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
