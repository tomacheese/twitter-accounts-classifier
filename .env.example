DATABASE_URL=postgresql://crawler:crawler@localhost:5432/twitter_accounts_classifier
# Cookie issuer service base URL - no default is provided; the crawler refuses to start without it.
COOKIE_ISSUER_URL=http://192.168.0.101:7006
CRAWL_INTERVAL_SECONDS=21600
CRAWL_STALE_THRESHOLD_MULTIPLIER=3
# GlitchTip (エラートラッキング) の DSN。開発機のローカル実行では未設定でよい。
GLITCHTIP_DSN=
