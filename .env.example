# crawler/blocker/migrate と、ローカルでの prisma CLI 実行に使う接続文字列。
# viewer コンテナは読み取り専用の viewer ロールで接続するため、下記 VIEWER_DB_PASSWORD を別途設定する。
DATABASE_URL=postgresql://crawler:crawler@localhost:5432/twitter_accounts_classifier
# Cookie issuer service base URL - no default is provided; the crawler refuses to start without it.
COOKIE_ISSUER_URL=http://192.168.0.101:7006
CRAWL_INTERVAL_SECONDS=21600
CRAWL_STALE_THRESHOLD_MULTIPLIER=3
# GlitchTip (エラートラッキング) の DSN。開発機のローカル実行では未設定でよい。
GLITCHTIP_DSN=
# 1 アカウントの crawl 1 回あたり、GlitchTip へ集約通知する warning 件数の閾値。未設定なら 5。
CRAWL_WARNING_THRESHOLD=
# analyzer ロールのパスワード。scripts/db/create-analyzer-role.sql の CHANGE_ME_ANALYZER_PASSWORD と同じ値にする。
ANALYZER_DB_PASSWORD=
# viewer ロールのパスワード。scripts/db/create-viewer-role.sql の CHANGE_ME_VIEWER_PASSWORD と同じ値にする。
VIEWER_DB_PASSWORD=
# 新 Viewer UI を有効化する区画。カンマ区切りで overview,review,accounts,labels,operations,blocks,system を指定する。
# 空または未設定の場合は新 UI を一切表示しない (旧 UI のみ)。
VIEWER_NEW_UI_SECTIONS=
