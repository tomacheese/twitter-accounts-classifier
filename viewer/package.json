{
  "name": "viewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --dir ../pipeline-health run build && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --dir ../pipeline-health run build",
    "test": "vitest run",
    "precheck": "pnpm run db:generate",
    "check": "run-p lint typecheck test",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma --generator viewerClient"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^8.0.0",
    "next": "^15.0.0",
    "pipeline-health": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.13.1",
    "@eslint/eslintrc": "^3.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^7.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
