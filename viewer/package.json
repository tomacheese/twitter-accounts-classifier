{
  "name": "viewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --dir ../pipeline-health run build && pnpm --dir ../id-boundary run build && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --dir ../pipeline-health run build && pnpm --dir ../id-boundary run build",
    "test": "vitest run",
    "precheck": "pnpm run db:generate",
    "check": "run-p lint typecheck test",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma --generator viewerClient && node ../prisma/scripts/stringify-bigint-types.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sentry/node": "11.14.0",
    "id-boundary": "workspace:*",
    "next": "15.5.29",
    "pipeline-health": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.1"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.13.1",
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "30.1.3",
    "npm-run-all2": "9.1.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
