{
  "name": "crawler",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r generated dist/generated",
    "crawl": "node dist/crawl.js",
    "relabel": "node dist/relabel.js",
    "benchmark:relabel": "tsx scripts/relabel-benchmark.ts",
    "backfill:recent-tweets": "tsx scripts/recent-tweets-backfill.ts",
    "backfill:card-destination-urls": "tsx scripts/card-destination-url-backfill.ts",
    "backfill:text-only-media": "tsx scripts/tweet-text-only-media-backfill.ts",
    "backfill:foreign-video-sources": "tsx scripts/foreign-video-source-backfill.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "precheck": "pnpm run db:generate",
    "check": "run-p lint typecheck test",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma && node ../prisma/scripts/stringify-bigint-types.mjs",
    "db:baseline": "bash ../prisma/baseline/apply.sh"
  },
  "prisma": {
    "seed": "tsx ../prisma/seed.ts"
  },
  "dependencies": {
    "@book000/node-utils": "1.26.35",
    "@prisma/client": "6.19.3",
    "@sentry/node": "11.14.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "id-boundary": "workspace:*",
    "twitter-client": "workspace:*",
    "twitter-openapi-typescript": "0.0.56",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.13.1",
    "@types/node": "26.6.11",
    "eslint": "9.39.5",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
