{
  "name": "analyzer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --dir ../pipeline-health run build && rm -rf dist && tsc -p tsconfig.json && cp -r generated dist/generated && cp policy/detection-policy.json dist/policy/detection-policy.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --dir ../pipeline-health run build",
    "test": "vitest run",
    "precheck": "pnpm run db:generate",
    "check": "run-p lint typecheck test",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma --generator analyzerClient",
    "backfill:remove-legacy-read-model-refresh-stage": "tsx scripts/backfill-remove-legacy-read-model-refresh-stage.ts",
    "cleanup:deprecated-work-item-kinds": "node dist/scripts/cleanup-deprecated-work-item-kinds.js"
  },
  "dependencies": {
    "@book000/node-utils": "^1.0.0",
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^8.0.0",
    "pipeline-health": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.13.1",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
